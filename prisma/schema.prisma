  // Feedback
  feedback    String?  // "helpful", "not_helpful", null
  feedbackAt  DateTime?
  
  createdAt DateTime @default(now())
  
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  @@index([sessionId])
  @@index([role])
  @@map("chat_messages")
}

model ChatFeedback {
