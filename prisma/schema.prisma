// ============================================
// PHASE 6H: LOGISTICS & SHIPPING
// ============================================

enum ShippingMethod {
  STANDARD
  EXPRESS
  AIR_FREIGHT
  SEA_FREIGHT
  RAIL_FREIGHT
  PICKUP
  WHITE_GLOVE
}

enum Incoterm {
  EXW        // Ex Works
  FCA        // Free Carrier
  CPT        // Carriage Paid To
  CIP        // Carriage and Insurance Paid To
  DAP        // Delivered at Place
  DDP        // Delivered Duty Paid
  FAS        // Free Alongside Ship
  FOB        // Free on Board
  CFR        // Cost and Freight
  CIF        // Cost Insurance and Freight
}

enum ShipmentStatus {
  PENDING
  READY_TO_SHIP
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  RETURNED
  LOST
}

model ShippingRate {
  id                String           @id @default(cuid())
  
  // Route
  originWilaya      String
  destinationWilaya String
  
  // Method & Pricing
  method            ShippingMethod
  basePrice         Float
  weightPrice       Float?            // Price per kg
  volumePrice       Float?            // Price per m³
  
  // Constraints
  minWeight         Float?            // kg
  maxWeight         Float?            // kg
  minDimensions     String?           // JSON {length, width, height}
  maxDimensions     String?           // JSON {length, width, height}
  
  // Timeframe
  estimatedDaysMin  Int
  estimatedDaysMax  Int
  
  // Carrier
  carrierName       String?
  trackingSupported Boolean          @default(false)
  
  // Validity
  effectiveFrom     DateTime
  effectiveUntil    DateTime?
  
  isActive          Boolean           @default(true)
  
  shipments         Shipment[]
  
  createdAt         DateTime          @default(now())
  
  @@index([originWilaya, destinationWilaya])
  @@index([method])
  @@map("shipping_rates")
}

model Shipment {
  id                String         @id @default(cuid())
  trackingNumber    String         @unique
  orderId           String
  
  // Shipping Method
  shippingMethod    ShippingMethod
  shippingRateId    String?
  
  // Addresses
  originAddress     String           // JSON {name, phone, address, wilaya, commune}
  destinationAddress String         // JSON {name, phone, address, wilaya, commune}
  
  // Incoterms
  incoterm          Incoterm         @default(DAP)
  
  // Dimensions & Weight
  weight            Float?           // Total weight in kg
  dimensions        String?          // JSON {length, width, height, unit}
  packageCount      Int              @default(1)
  
  // Cost
  shippingCost      Float
  currency          String           @default("DZD")
  
  // Status
  status            ShipmentStatus    @default(PENDING)
  
  // Tracking
  trackingEventsData String?          // JSON array of tracking events
  estimatedDelivery DateTime?
  actualDelivery    DateTime?
  
  // Carrier Info
  carrierName       String?
  carrierTrackingUrl String?
  
  // Documents
  waybillUrl        String?
  customsDocsUrl    String?
  insuranceUrl      String?
  
  order             Order            @relation("OrderShipments", fields: [orderId], references: [id])
  rate              ShippingRate?    @relation(fields: [shippingRateId], references: [id])
  trackingEvents    TrackingEvent[]  @relation("ShipmentTrackingEvents")
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  
  @@index([orderId])
  @@index([trackingNumber])
  @@index([status])
  @@map("shipments")
}

model TrackingEvent {
  id                String   @id @default(cuid())
  shipmentId        String
  
  // Event Details
  status            String   // Description of event
  location          String?
  timestamp         DateTime
  
  // Additional Info
  description       String?
  imageUrl          String?   // Photo proof of delivery
  
  shipment          Shipment  @relation("ShipmentTrackingEvents", fields: [shipmentId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime @default(now())
  
  @@index([shipmentId])
  @@map("tracking_events")
}

// ============================================
// CRM MODULE (Phase 8I)
// ============================================

model CRMContact {
  id                      String    @id @default(cuid())
  companyId               String
  userId                  String?
  
  // Personal Info
  firstName               String
  lastName                String
  email                   String
  phone                   String
  mobile                  String?
  jobTitle                String
  department              String?
  role                    String    @default("DECISION_MAKER")
  
  // Social/Professional
  linkedinUrl             String?
  avatarUrl               String?
  
  // Preferences
  preferredLanguage       String    @default("FR")
  preferredContactMethod String    @default("EMAIL")
  timezone                String    @default("Africa/Algiers")
  
  // Tags & Notes
  tags                    String    @default("[]") // JSON array
  notes                   String?
  
  lastInteractionAt       DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  
  interactions            CRMInteraction[]
  
  @@index([companyId])
  @@index([email])
  @@index([lastName])
  @@map("crm_contacts")
}

model CRMLead {
  id                      String    @id @default(cuid())
  leadNumber              String    @unique
  
  // Source Info
  source                  String
  sourceDetails           String?
  campaignId              String?
  
  // Company Info
  companyName             String
  industry                String?
  companySize             String?
  website                 String?
  wilaya                  String?
  city                    String?
  
  // Contact Person
  primaryContactId        String
  
  // Pipeline
  status                  String    @default("NEW")
  pipelineStage           String
  estimatedValue          Float
  currency                String    @default("DZD")
  probability             Int       @default(0)
  expectedCloseDate       DateTime
  
  // Assignment
  assignedTo              String
  teamId                  String?
  
  // Products/Services Interest
  interestedCategories    String    @default("[]") // JSON array
  interestedProducts      String    @default("[]") // JSON array
  specificRequirements    String?
  
  // Scoring
  leadScore               Int       @default(0)
  engagementScore         Int       @default(0)
  
  // Conversion
  convertedToCompanyId    String?
  convertedToOrderId      String?
  convertedAt             DateTime?
  
  // Loss Analysis
  lostReason              String?
  lostToCompetitor        String?
  
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  
  tasks                   CRMTask[]
  interactions            CRMInteraction[]
  
  @@index([assignedTo])
  @@index([status])
  @@index([source])
  @@index([expectedCloseDate])
  @@map("crm_leads")
}

model CRMTask {
  id                      String    @id @default(cuid())
  leadId                  String?
  contactId               String?
  companyId               String
  
  title                   String
  description             String
  type                    String    @default("OTHER") // CALL, EMAIL, MEETING, FOLLOW_UP, PROPOSAL, DEMO, REMINDER, OTHER
  priority                String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status                  String    @default("TODO") // TODO, IN_PROGRESS, COMPLETED, CANCELLED, DEFERRED
  
  dueDate                 DateTime
  dueTime                 String?
  completedAt             DateTime?
  
  assignedTo              String
  createdBy               String
  
  // Reminders
  remindBefore            Int       @default(60) // Minutes before
  reminderSent            Boolean   @default(false)
  
  // Result
  resultNotes             String?
  outcome                 String?
  
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  
  lead                    CRMLead?   @relation(fields: [leadId], references: [id])
  
  @@index([assignedTo])
  @@index([status])
  @@index([dueDate])
  @@map("crm_tasks")
}

model CRMInteraction {
  id                      String    @id @default(cuid())
  contactId               String
  leadId                  String?
  companyId               String
  
  type                    String    // CALL, EMAIL, MEETING, NOTE, SYSTEM, CHAT, QUOTE_SENT, ORDER_PLACED
  direction               String    // INBOUND, OUTBOUND
  
  subject                 String
  content                 String
  
  // Metadata
  duration                Int?      // Minutes for calls/meetings
  channel                 String?   // Email, Phone, WhatsApp, etc.
  
  // Outcomes
  sentiment               String?   // POSITIVE, NEUTRAL, NEGATIVE
  nextSteps               String?
  
  // Attachments
  attachmentUrls          String    @default("[]") // JSON array
  
  // Automation
  automated               Boolean   @default(false)
  triggeredBy             String?
  
  createdBy               String
  createdAt               DateTime  @default(now())
  
  contact                 CRMContact @relation(fields: [contactId], references: [id])
  lead                    CRMLead?   @relation(fields: [leadId], references: [id])
  
  @@index([contactId])
  @@index([leadId])
  @@index([createdAt])
  @@map("crm_interactions")
}

model CRMPipeline {
  id                      String    @id @default(cuid())
  name                    String
  description             String?
  stages                  Json // PipelineStage[]
  defaultLeadStatus       String    @default("NEW")
  
  isPublic                Boolean   @default(true)
  allowedRoles            String    @default("[]") // JSON array
  
  autoAdvanceRules        Json // AutoAdvanceRule[]
  
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  
  @@map("crm_pipelines")
}

model CRMSegment {
  id                      String    @id @default(cuid())
  name                    String
  description             String?
  filters                 Json // SegmentFilter[]
  contactCount            Int       @default(0)
  lastCalculated          DateTime?
  createdAt               DateTime  @default(now())
  
  @@map("crm_segments")
}

model CRMAutomationRule {
  id                      String    @id @default(cuid())
  name                    String
  eventType               String    // LEAD_CREATED, LEAD_STAGE_CHANGED, TASK_COMPLETED, INTERACTION_LOGGED, etc.
  conditions              Json // Condition[]
  actions                 Json // Action[]
  enabled                 Boolean   @default(true)
  lastTriggeredAt         DateTime?
  executionCount          Int       @default(0)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  
  @@map("crm_automation_rules")
}

// ============================================
// ERP INTEGRATION MODULE (Phase 8J)
// ============================================

model ERPConfig {
  id                      String    @id @default(cuid())
  name                    String
  type                    String    // SAP, ODOO, DYNAMICS, CUSTOM
  enabled                 Boolean   @default(false)
  
  // Connection
  endpoint                String
  apiKey                  String?
  username                String?
  password                String?
  clientId                String?
  clientSecret            String?
  authType                String    @default("API_KEY") // API_KEY, BASIC, OAUTH2, CERTIFICATE
  
  // Sync Settings
  defaultSyncFreq         String    @default("DAILY") // REALTIME, EVERY_5_MIN, HOURLY, DAILY, MANUAL
  syncDirections          Json
  fieldMappings           Json
  
  // Webhook
  webhookSecret           String?
  webhookEndpoint         String?
  
  // Status
  lastSyncAt              DateTime?
  connectionStatus        String    @default("UNKNOWN") // UNKNOWN, CONNECTED, ERROR
  
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  
  syncLogs                ERPSyncLog[]
  inventorySyncRules      InventorySyncRule[]
  
  @@unique([name, type])
  @@map("erp_configs")
}

model ERPSyncLog {
  id                      String    @id @default(cuid())
  erpConfigId             String
  entityType              String    // PRODUCTS, INVENTORY, ORDERS, CUSTOMERS, PRICES, CATEGORIES, SUPPLIERS, INVOICES, SHIPMENTS
  direction               String    // PUSH, PULL
  status                  String    @default("PENDING") // SUCCESS, FAILED, PARTIAL, PENDING, SKIPPED
  
  recordsProcessed        Int       @default(0)
  recordsSuccess          Int       @default(0)
  recordsFailed           Int       @default(0)
  errors                  String    @default("[]") // JSON array of errors
  
  startedAt               DateTime  @default(now())
  completedAt             DateTime?
  durationMs              Int?
  
  erpConfig               ERPConfig  @relation(fields: [erpConfigId], references: [id], onDelete: Cascade)
  
  @@index([erpConfigId])
  @@index([status])
  @@index([startedAt])
  @@map("erp_sync_logs")
}

model InventorySyncRule {
  id                      String    @id @default(cuid())
  erpConfigId             String
  productCategory         String?   // Apply to category
  syncFrequency           String    @default("DAILY")
  conflictResolution      String    @default("ERP_WINS") // PLATFORM_WINS, ERP_WINS, MANUAL, LATEST_WINS
  lowStockThreshold       Int       @default(10) // Alert when below this
  enableBackorders        Boolean   @default(false)
  reserveStockOnOrder     Boolean   @default(true) // Reserve ERP stock when order placed
  
  erpConfig               ERPConfig  @relation(fields: [erpConfigId], references: [id], onDelete: Cascade)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  
  @@index([erpConfigId])
  @@map("inventory_sync_rules")
}

// Extended ERP Connector Model for Multi-tenant Support
model ErpConnector {
  id                      String    @id @default(cuid())
  userId                  String    // Owner user ID
  name                    String    // Display name
  type                    String    // SAP, ODOO, DYNAMICS, CUSTOM, REST
  displayName             String?   // Optional display name
  
  // Connection Settings (Encrypted)
  credentials             String    @default("{}") // Encrypted connection credentials as JSON string
  
  // Status
  status                  String    @default("DISCONNECTED") // CONNECTED, DISCONNECTED, ERROR, SYNCING
  
  // Sync Tracking
  lastSyncAt              DateTime?
  nextSyncAt              DateTime?
  errorCount              Int       @default(0)
  errorMessage            String?
  
  // Configuration
  fieldMappings           String    @default("[]") // Array of field mappings as JSON string
  syncConfig              String    @default("{}") // Sync schedule, direction, etc. as JSON string
  
  // Metadata
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  
  // Relations
  syncLogs                ErpSyncLogNew[]
  inventoryRecords        InventorySyncRecord[]
  
  @@index([userId])
  @@index([type])
  @@index([status])
  @@map("erp_connectors")
}

// Enhanced Sync Log for Connectors
model ErpSyncLogNew {
  id                      String    @id @default(cuid())
  connectorId             String
  
  // Sync Details
  direction               String    // PUSH, PULL, BIDIRECTIONAL
  entityType              String    // PRODUCTS, INVENTORY, ORDERS, etc.
  
  // Results
  recordsProcessed        Int       @default(0)
  recordsSuccess          Int       @default(0)
  recordsFailed           Int       @default(0)
  
  // Timing
  startedAt               DateTime  @default(now())
  completedAt             DateTime?
  durationSeconds         Int?
  
  // Status & Errors
  status                  String    @default("PENDING") // SUCCESS, FAILED, PARTIAL, PENDING
  errorMessage           String?
  details                 String    @default("{}") // JSON string
  
  // Relation
  connector               ErpConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  
  @@index([connectorId])
  @@index([status])
  @@index([startedAt])
  @@map("erp_sync_logs_new")
}

// Inventory Sync Record for tracking synced products
model InventorySyncRecord {
  id                      String    @id @default(cuid())
  connectorId             String
  
  // Product Mapping
  externalProductId       String?   // ERP product ID
  internalProductId       String    // Local product ID
  externalSku             String?
  internalSku             String?
  
  // Stock Info
  quantity                Float     @default(0)
  
  // Sync Status
  lastSyncedAt            DateTime?
  syncStatus              String    @default("PENDING") // SYNCED, PENDING, ERROR, CONFLICT
  
  // Relation
  connector               ErpConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  
  @@unique([connectorId, externalProductId])
  @@unique([connectorId, internalProductId])
  @@index([internalSku])
  @@map("inventory_sync_records")
}

// ============================================
// NEGOTIATION SYSTEM - Advanced Offer/Counter-Offer
// ============================================

model Negotiation {
  id                String            @id @default(cuid())
  negotiationNumber String            @unique // NEG-YYYYMMDD-XXXX
  
  // Related entities
  productId         String?
  orderId           String?
  rfqId             String?
  
  // Parties
  buyerId           String
  sellerId          String
  initiatorId       String // Who started it
  currentRole       String             @default("BUYER") // BUYER or SELLER - Whose turn
  
  // Status tracking
  status            String             @default("DRAFT") // DRAFT, SENT, UNDER_REVIEW, COUNTERED, ACCEPTED, REJECTED, EXPIRED, WITHDRAWN, ARCHIVED
  type              String             @default("PRICE") // PRICE, QUANTITY, DELIVERY_TERMS, PAYMENT_TERMS, SPECIFICATIONS, BUNDLE, COMPREHENSIVE
  
  // Progress
  totalOffers       Int                @default(0)
  counterOffers     Int                @default(0)
  lastOfferAt       DateTime
  concludedOutcome  String?            // Accepted price, terms summary
  
  // Settings
  maxDuration       Int                @default(30) // Days before auto-expire
  autoAcceptThreshold Float?           // If offer within X% of asking, auto-accept
  isPrivate         Boolean            @default(false) // Hidden from other suppliers
  allowCounterOffer Boolean            @default(true)
  
  startedAt         DateTime           @default(now())
  concludedAt       DateTime?
  
  offers            NegotiationOffer[]
  
  product           Product?          @relation("ProductNegotiations", fields: [productId], references: [id])
  order             Order?            @relation("OrderNegotiations", fields: [orderId], references: [id])
  
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([productId])
  @@map("negotiations")
}

model NegotiationOffer {
  id                String            @id @default(cuid())
  negotiationId     String
  offerNumber       Int               // Sequential per negotiation
  fromRole           String            // BUYER or SELLER
  fromUserId        String
  toUserId          String
  
  // Content
  type              String             @default("PRICE")
  originalPrice     Float?
  offeredPrice      Float?
  quantity          Float?
  deliveryDays      Int?
  paymentTerms      String?
  specifications    Json?              // Record<string, any>
  notes             String?
  
  // AI Analysis (optional)
  aiScore           Int?               // 0-100, how fair is this offer?
  aiSuggestion      String?
  marketComparison  Json?              // { averagePrice, percentile }
  
  // Timestamps
  validUntil        DateTime           // Offer expiry (default 72h)
  respondedAt       DateTime?
  status            String             @default("PENDING") // PENDING, ACCEPTED, REJECTED, COUNTERED, EXPIRED
  
  createdAt         DateTime           @default(now())
  
  negotiation       Negotiation        @relation(fields: [negotiationId], references: [id], onDelete: Cascade)
  
  @@index([negotiationId])
  @@index([status])
  @@map("negotiation_offers")
}

// ============================================
// CONTRACT SYSTEM - Legal Document Generation
// ============================================

model Contract {
  id                  String            @id @default(cuid())
  contractNumber      String            @unique // CTR-YYYYMMDD-XXXX
  contractType        String            // SALES_AGREEMENT, SUPPLY_CONTRACT, SERVICE_AGREEMENT, DISTRIBUTION_AGREEMENT, NON_DISCLOSURE, EXCLUSIVITY, FRAMEWORK_AGREEMENT
  status              String            @default("DRAFT") // DRAFT, REVIEW, PENDING_SIGNATURE, SIGNED, ACTIVE, EXPIRED, TERMINATED, VOID
  language            String            @default("BILINGUAL") // AR, FR, BILINGUAL
  
  // Parties (JSON serialized ContractParty)
  partyAInfo          Json              // Supplier info
  partyBInfo          Json              // Buyer info
  
  // Subject matter
  subject             String
  subjectAr           String
  subjectFr           String
  effectiveDate       DateTime
  endDate             DateTime?         // Null for indefinite
  
  // Financial terms
  totalValue          Float             @default(0)
  currency            String            @default("DZD")
  paymentTerms        String
  penaltyClause       String?           // Late payment penalties
  warrantyTerms       String?
  
  // Clauses (JSON arrays)
  clauses             Json              // ContractClause[]
  customClauses       Json              // Custom ContractClause[]
  
  // Signatures
  partyASignedAt      DateTime?
  partyBSignedAt      DateTime?
  partyASignatureUrl  String?
  partyBSignatureUrl  String?
  
  // Versioning
  version             Int               @default(1)
  parentContractId    String?           // For amendments
  
  // Metadata
  createdBy           String
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  
  relatedNegotiationId String?
  relatedOrderId      String?
  
  attachments        ContractAttachment[]
  
  @@index([contractType])
  @@index([status])
  @@index([createdBy])
  @@map("contracts")
}

model ContractAttachment {
  id              String    @id @default(cuid())
  contractId      String
  fileName        String
  fileType        String   // PDF, DOCX, IMAGE, OTHER
  fileSize        Int      // bytes
  fileUrl         String
  uploadedBy      String
  description     String?
  
  createdAt       DateTime @default(now())
  
  contract        Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  
  @@index([contractId])
  @@map("contract_attachments")
}

// ============================================
// PHASE 8D: INSTALLMENT PLANS (DPA)
// ============================================

enum InstallmentPlanType {
  DPA_30_DAYS      // 30-day deferred (common in Algeria)
  DPA_60_DAYS      // 60-day deferred
  DPA_90_DAYS      // 90-day deferred (with bank guarantee)
  INSTALLMENT_3X   // 3 equal monthly installments
  INSTALLMENT_6X   // 6 equal monthly installments
  INSTALLMENT_12X  // 12 monthly installments (large orders)
  CUSTOM           // Custom plan negotiated
}

enum InstallmentStatus {
  PENDING_APPROVAL // Awaiting seller/bank approval
  APPROVED         // Plan approved, payments scheduled
  ACTIVE           // Payments in progress
  DELINQUENT       // Payment overdue
  DEFAULTED        // Failed to pay
  COMPLETED        // All installments paid
  CANCELLED        // Plan cancelled
}

model InstallmentPlan {
  id                    String            @id @default(cuid())
  orderId               String           @unique
  buyerId               String
  sellerId              String
  type                  InstallmentPlanType
  status                InstallmentStatus @default(PENDING_APPROVAL)
  
  totalAmount           Float
  downPayment           Float             // Initial payment (usually 30%)
  remainingBalance      Float
  installmentCount      Int
  installmentAmount     Float
  interestRate          Float             @default(0) // APR
  totalInterest         Float             @default(0)
  
  firstPaymentDate      DateTime
  frequency             String            @default("MONTHLY") // MONTHLY, BI_MONTHLY, QUARTERLY
  
  bankGuaranteeRequired Boolean           @default(false)
  bankGuarrantyDocument String?
  
  approvedAt            DateTime?
  approvedBy            String?           // Admin/Seller ID
  
  nextInstallmentDue    DateTime?
  installmentsPaid      Int               @default(0)
  
  notes                 String?
  
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  
  installments          Installment[]
  
  @@index([buyerId])
  @@index([sellerId])
  @@index([orderId])
  @@index([status])
  @@map("installment_plans")
}

model Installment {
  id                String    @id @default(cuid())
  planId            String
  installmentNumber Int
  dueDate           DateTime
  amount            Float
  principalPortion  Float
  interestPortion   Float
  paidAt            DateTime?
  paymentMethod     String?
  transactionId     String?
  status            String    @default("PENDING") // PENDING, PAID, OVERDUE, PARTIAL, WAIVED
  lateFeeApplied    Float     @default(0)
  notes             String?
  
  plan              InstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  
  @@index([planId])
  @@index([status])
  @@index([dueDate])
  @@map("installments")
}

// ============================================
// PHASE 1-D: ADVANCED DPA (DEFERRED PAYMENT AGREEMENT) SYSTEM
// Enhanced installment plans for large B2B orders
// Compliant with Bank of Algeria regulations
// ============================================

/// DPA Agreement Status - Full lifecycle management
enum DPAStatus {
  DRAFT               // Initial application draft
  PENDING_APPROVAL    // Awaiting seller approval
  PENDING_DOCUMENTS   // Additional documents required
  UNDER_REVIEW        // Credit assessment in progress
  APPROVED            // Seller approved, awaiting activation
  ACTIVE              // Payments in progress
  PAID                // All installments paid successfully
  DEFAULTED           // Buyer failed to pay
  CANCELLED           // Cancelled by buyer or seller
  EARLY_SETTLED       // Paid off early with discount
}

/// Individual Installment Status for DPA
enum DPAInstallmentStatus {
  PENDING             // Not yet due
  PAID                // Fully paid
  PARTIAL             // Partial payment received
  OVERDUE             // Past due date
  WAIVED              // Waived by seller/admin
}

/// Document types for DPA verification
enum DPADocumentType {
  ID_CARD             // National ID card
  PASSPORT            // Passport
  BUSINESS_REG        // Business registration (RC)
  BANK_STATEMENT      // Bank statement (last 3 months)
  TAX_RETURN          // Tax return document
  FINANCIAL_STATEMENT // Audited financial statements
  BANK_GUARANTEE      // Bank guarantee letter
  COMMERCIAL_REGISTER // Registre de Commerce
  NIF_CERTIFICATE     // NIF certificate
  OTHER               // Other supporting documents
}

/// Document verification status
enum DPADocumentStatus {
  PENDING             // Awaiting review
  VERIFIED            // Document verified
  REJECTED            // Document rejected
}

model DPAgreement {
  id                    String           @id @default(cuid())
  agreementNumber       String           @unique // Format: DPA-YYYYMMDD-XXXXX
  
  // Related entities
  orderId               String           @unique // One DPA per order
  buyerId               String
  sellerId               String
  
  // Financial terms (using Float for SQLite compatibility)
  principalAmount       Float // Original order amount
  interestRate          Float // Total interest percentage
  adminFee              Float @default(0) // Administrative fee
  insurancePremium      Float? // Optional insurance premium
  totalAmount           Float // Principal + interest + fees
  
  // Schedule configuration
  planId                String                            // dpa-3m, dpa-6m, dpa-12m, dpa-24m
  totalInstallments     Int                               // Number of installments
  installmentAmount     Float // Fixed monthly amount
  firstDueDate          DateTime                          // First payment due date
  frequency             String           @default("MONTHLY") // MONTHLY, BI_MONTHLY
  
  // Status tracking
  status                DPAStatus        @default(DRAFT)
  downPaymentReceived   Boolean          @default(false)
  downPaymentAmount     Float?
  
  // Insurance/Guarantee
  insuranceEnabled      Boolean          @default(false)
  bankPartnerId         String?                          // Partner bank ID if using bank DPA
  guaranteeReference    String?                          // Bank guarantee reference
  
  // Credit assessment
  creditScore           Int?                              // Calculated credit score
  riskLevel             String?                           // LOW, MEDIUM, HIGH, VERY_HIGH
  
  // Key dates
  appliedAt             DateTime        @default(now())
  approvedAt            DateTime?
  activatedAt           DateTime?
  completedAt           DateTime?
  
  // Audit trail
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  
  // Relations
  installments          DPAInstallment[]
  payments              DPPayment[]
  documents             DPADocument[]
  order                 Order?            @relation(fields: [orderId], references: [id])
  buyer                User             @relation("DPABuyer", fields: [buyerId], references: [id])
  seller               User             @relation("DPASeller", fields: [sellerId], references: [id])
  
  @@index([buyerId])
  @@index([sellerId])
  @@index([orderId])
  @@index([status])
  @@index([appliedAt])
  @@map("dp_agreements")
}

/// Individual installment within a DPA agreement
model DPAInstallment {
  id                    String              @id @default(cuid())
  agreementId           String
  installmentNumber     Int                 // 1, 2, 3...N
  dueDate               DateTime
  amount                Float
  principalPortion      Float
  interestPortion       Float
  status                DPAInstallmentStatus @default(PENDING)
  paidAmount            Float               @default(0)
  paidAt                DateTime?
  lateFeeApplied        Float               @default(0)
  lateFeePaid           Float               @default(0)
  notes                 String?
  
  agreement             DPAgreement         @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  payments              DPPayment[]
  
  @@index([agreementId])
  @@index([dueDate])
  @@index([status])
  @@map("dpa_installments")
}

/// Payment records for DPA agreements
model DPPayment {
  id                    String    @id @default(cuid())
  agreementId           String
  installmentId         String?
  amount                Float
  paymentMethod         String    // SATIM, BARIDIMOB, BANK_TRANSFER, CHECK, etc.
  paymentReference      String?  // Transaction reference number
  notes                 String?
  createdAt             DateTime @default(now())
  
  agreement             DPAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  installment           DPAInstallment? @relation(fields: [installmentId], references: [id])
  
  @@index([agreementId])
  @@index([createdAt])
  @@map("dpa_payments")
}

/// Supporting documents for DPA applications
model DPADocument {
  id                    String           @id @default(cuid())
  agreementId           String
  documentType          DPADocumentType
  fileName              String
  fileUrl               String           // Storage URL or path
  fileSize              Int              // File size in bytes
  mimeType              String
  uploadedAt            DateTime         @default(now())
  verifiedAt            DateTime?
  verifiedBy            String?          // Admin user ID who verified
  status                DPADocumentStatus @default(PENDING)
  rejectionReason       String?
  
  agreement             DPAgreement      @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  
  @@index([agreementId])
  @@index([documentType])
  @@index([status])
  @@map("dpa_documents")
}

// ============================================
// PHASE 8E: PROFESSIONAL INVOICE SYSTEM WITH TVA
// Compliant with Algerian Tax Regulations
// ============================================

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIAL
  OVERDUE
  CANCELLED
  REFUNDED
}

enum InvoiceType {
  STANDARD        // Renamed from COMMERCIAL for clarity
  PROFORMA
  CREDIT_NOTE
  DEBIT_NOTE
  DOWN_PAYMENT
  INSTALLMENT
}

model Invoice {
  id                  String        @id @default(cuid())
  invoiceNumber       String        @unique
  invoiceType         InvoiceType   @default(STANDARD)
  
  // Entities
  orderId             String?
  sellerId            String
  buyerId             String
  
  // Status
  status              InvoiceStatus @default(DRAFT)
  
  // Dates
  issueDate           DateTime
  dueDate             DateTime?
  paidAt              DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  
  // Financials (using Float for SQLite compatibility with decimals)
  subtotal            Float         @default(0)
  discountAmount      Float         @default(0)
  discountPercent     Float         @default(0)
  taxableBase         Float         @default(0)
  tvaAmount           Float         @default(0)
  totalAmount         Float         @default(0)
  amountPaid          Float         @default(0)
  amountDue           Float         @default(0)
  currency            String        @default("DZD")
  
  // Payment terms (standardized codes)
  paymentTerms        String        @default("NET30") // IMMEDIATE, NET30, NET60, NET90, EOM
  notes               String?
  internalNotes       String?      // Only visible to seller
  
  // References
  parentInvoiceId     String?      // For credit/debit notes referencing original
  quotedInvoiceId     String?      // Proforma this fulfills
  pdfPath             String?
  
  // Relations
  items               InvoiceItem[]
  tvaBreakdown        TVABreakdown[]
  payments            InvoicePayment[]
  
  // Self-referencing for credit/debit notes
  parentInvoice       Invoice?      @relation("CreditNotes", fields: [parentInvoiceId], references: [id])
  creditNotes         Invoice[]     @relation("CreditNotes")
  
  // User relations (optional - can be derived from sellerId/buyerId)
  // seller              User         @relation(fields: [sellerId], references: [id], name: "InvoiceSeller")
  // buyer               User         @relation(fields: [buyerId], references: [id], name: "InvoiceBuyer")
  // order               Order?       @relation(fields: [orderId], references: [id])
  
  @@index([sellerId])
  @@index([buyerId])
  @@index([orderId])
  @@index([status])
  @@index([issueDate])
  @@index([invoiceNumber])
  @@index([parentInvoiceId])
  @@map("invoices")
}

model InvoiceItem {
  id                  String        @id @default(cuid())
  invoiceId           String
  productId           String?
  description         String        // Product/service description
  quantity            Float         @default(1)
  unitPrice           Float         @default(0)
  discount            Float         @default(0)  // Percentage (0-100)
  lineTotal           Float         @default(0)
  tvaRate             Float         @default(19) // TVA percentage (-1=exempt, 0, 9, 19)
  tvaAmount           Float         @default(0)
  lineTotalWithTax    Float         @default(0)
  productSku          String?
  unitOfMeasure       String?       // kg, units, m², etc.
  sortOrder           Int           @default(0)
  
  invoice             Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_items")
}

model TVABreakdown {
  id                  String        @id @default(cuid())
  invoiceId           String
  tvaRate             Float         // 19, 9, 0, or -1 for exempt
  taxableBase         Float         @default(0)
  tvaAmount           Float         @default(0)
  
  invoice             Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  @@unique([invoiceId, tvaRate])
  @@index([invoiceId])
  @@map("tva_breakdowns")
}

model InvoicePayment {
  id                  String        @id @default(cuid())
  invoiceId           String
  amount              Float         @default(0)
  paymentMethod       String        // CIB, CCP, BARIDIMOB, BANK_TRANSFER, CRYPTO, etc.
  paymentReference    String?
  notes               String?
  paidAt              DateTime      @default(now())
  
  invoice             Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  @@index([invoiceId])
  @@index([paidAt])
  @@map("invoice_payments")
}

// ============================================
// PHASE 8C + 8F: CRYPTO PAYMENTS & MULTI-CURRENCY SUPPORT
// ============================================

/// Exchange rates for multi-currency support
model ExchangeRate {
  id            String   @id @default(cuid())
  fromCurrency  String   // DZD (base currency)
  toCurrency    String   // USD, EUR, GBP, CAD, TND, MAD, CHF
  rate          String   // Stored as string for precision (Decimal equivalent)
  source        String   @default("ecb") // 'fixer', 'ecb', 'openexchangerates', 'manual', 'fallback'
  fetchedAt     DateTime @default(now())
  validUntil    DateTime? // When this rate expires
  
  @@unique([fromCurrency, toCurrency, source])
  @@index([toCurrency])
  @@index([validUntil])
  @@index([fetchedAt])
  @@map("exchange_rates")
}

/// User's preferred currency for display
model CurrencyPreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  currency      String   @default("DZD") // DZD, EUR, USD, etc.
  autoDetect    Boolean  @default(true) // Auto-detect from location/IP
  lastUpdated   DateTime @default(now())
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@map("currency_preferences")
}

/// Log of all currency conversions for analytics and auditing
model ConversionLog {
  id              String   @id @default(cuid())
  userId          String?
  fromAmount      String   // Stored as string for precision
  fromCurrency    String
  toAmount        String   // Converted amount
  toCurrency      String
  rateUsed        String   // Rate at time of conversion
  context         String?  // product_view, cart, checkout, converter_widget, etc.
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime @default(now())
  
  user            User?    @relation("UserConversionLogs", fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([fromCurrency, toCurrency])
  @@index([createdAt])
  @@map("conversion_logs")
}

/// Cryptocurrency payments tracking - Enhanced for multi-network support
model CryptoPayment {
  id                      String   @id @default(cuid())
  paymentId               String   @unique // Public payment identifier (e.g., CPABC123...)
  orderId                 String   @unique // One crypto payment per order
  userId                  String
  
  // Crypto details
  cryptocurrency          String   // USDT, BTC, ETH, USDC
  network                 String?  // TRC20, ERC20, BEP20, mainnet
  amount                  String   // Crypto amount (string for precision)
  amountInDZD             String   // Original order amount in DZD
  exchangeRate            String   // Rate at time of payment
  networkFee              String?  // Estimated/paid fee
  
  // Wallet details
  receivingAddress        String   // Platform wallet address
  txHash                  String?  // Blockchain transaction hash
  senderAddress           String?  // From address (for tracking/refunds)
  
  // Status tracking
  status                  String   @default("PENDING") // PENDING, AWAITING_CONFIRMATION, CONFIRMING, COMPLETED, EXPIRED, FAILED
  confirmations           Int      @default(0)
  requiredConfirmations   Int      @default(3)
  
  // Timestamps
  expiresAt               DateTime // When quote expires
  confirmedAt             DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  
  // Raw data from blockchain APIs
  blockchainResponse      Json?
  
  // Relations
  user                    User     @relation(fields: [userId], references: [id])
  order                   Order?   @relation(fields: [orderId], references: [id])
  
  @@index([userId])
  @@index([status])
  @@index([cryptocurrency])
  @@index([txHash])
  @@index([expiresAt])
  @@map("crypto_payments")
}

/// Exchange rate cache for cryptocurrency conversions
model CryptoRateCache {
  id              String   @id @default(cuid())
  cryptocurrency  String
  rateToDZD       String   // Stored as string for precision
  source          String   // coingecko, binance, fallback
  fetchedAt       DateTime @default(now())
  expiresAt       DateTime
  
  @@unique([cryptocurrency, source])
  @@index([expiresAt])
  @@map("crypto_rate_cache")
}

// ============================================
// PHASE 8K: WEBRTC VOICE/VIDEO CALLS
// ============================================

/// WebRTC call records for in-platform voice/video calling
model WebRTCCall {
  id                  String    @id @default(cuid())
  
  // Call configuration
  callType            String    // AUDIO, VIDEO, SCREEN_SHARE
  status              String    @default("RINGING") // RINGING, CONNECTED, ON_HOLD, ENDED, DECLINED, FAILED
  
  // Participants
  callerId            String
  callerName          String
  callerAvatar        String?
  calleeId            String
  calleeName          String
  calleeAvatar        String?
  
  // Context (what triggered the call)
  contextType         String    @default("DIRECT") // DIRECT, ORDER_RELATED, PRODUCT_QUESTION, SUPPORT
  contextId           String?   // Order ID, Product ID, etc.
  
  // Timing
  initiatedAt         DateTime  @default(now())
  connectedAt         DateTime?
  endedAt             DateTime?
  durationSeconds     Int?
  
  // Media quality settings
  mediaQuality        String    @default("HD") // SD, HD, FHD, UHD
  
  // WebRTC data (stored for debugging)
  offerSdp            String?   // SDP offer from caller
  answerSdp           String?   // SDP answer from callee
  iceCandidates       String    @default("[]") // JSON array of ICE candidates
  
  // Recording
  isRecording         Boolean   @default(false)
  recordingUrl        String?
  
  // AI Transcription (optional feature)
  transcription       String?   // Long text for transcription content
  transcriptionEnabled Boolean  @default(false)
  transcriptionLanguage String?
  
  // Premium features / cost tracking
  isPremiumCall       Boolean   @default(false)
  costPerMinute       String?   // Cost per minute in DZD (stored as string for precision)
  totalCost           String?   // Total call cost in DZD (stored as string for precision)
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  @@index([callerId])
  @@index([calleeId])
  @@index([status])
  @@index([initiatedAt])
  @@map("webrtc_calls")
}

// ============================================
// PHASE 8L: AUGMENTED REALITY (AR) SHOWROOM
// ============================================

/// 3D models for AR product viewing
model ARProductModel {
  id                  String    @id @default(cuid())
  productId           String    @unique  // Reference to product
  
  // Model files
  modelUrl            String    // CDN URL to 3D model file
  thumbnailUrl        String    // Preview thumbnail URL
  format              String    // GLTF, GLB, USDZ, FBX
  
  // Transform defaults (stored as JSON strings)
  scale               String    @default("{\"x\":1,\"y\":1,\"z\":1}")
  rotation            String    @default("{\"x\":0,\"y\":0,\"z\":0}")
  
  // Model metadata
  fileSize            Int       @default(0) // Size in KB
  polygonCount        Int       @default(0)
  optimizedForMobile  Boolean   @default(true)
  
  // Interactive elements (stored as JSON strings)
  hotspots            String    @default("[]") // Interactive click points
  animations          String    @default("[]") // Available animations
  materialVariations String    @default("[]") // Color/material options
  
  // Status & stats
  isEnabled           Boolean   @default(true)
  viewsCount          Int       @default(0)
  avgViewDuration     Int       @default(0) // Average view duration in seconds
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  viewEvents          ARViewEvent[]
  snapshots           ARSnapshot[]
  
  @@index([productId])
  @@index([isEnabled])
  @@map("ar_product_models")
}

/// AR viewer analytics events
model ARViewEvent {
  id                  String    @id @default(cuid())
  modelId             String
  
  // User info (anonymous if not logged in)
  userId              String?
  
  // Event type and details
  eventType           String    // VIEW, INTERACT, SHARE, HOTSPOT_CLICK, SCREENSHOT
  duration           Int?      // How long they viewed (seconds)
  
  // Device info
  deviceType          String    // mobile, desktop, tablet
  browserSupport      String    // WEBXR, THREEJS_FALLBACK
  userAgent           String?
  
  // Location (if available)
  ipAddress           String?
  country             String?
  
  createdAt           DateTime  @default(now())
  
  model               ARProductModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  
  @@index([modelId])
  @@index([eventType])
  @@index([createdAt])
  @@index([userId])
  @@map("ar_view_events")
}

/// AR Snapshots - Captured AR view images
model ARSnapshot {
  id                  String    @id @default(cuid())
  modelId             String
  userId              String
  
  // Image data
  imageUrl            String    // URL to full-size image
  thumbnailUrl        String?   // URL to thumbnail version
  
  // Timestamps
  capturedAt           DateTime  @default(now())
  
  // Sharing
  shared               Boolean   @default(false)
  shareToken           String?   @unique // Token for public sharing
  
  // Metadata (JSON string for flexibility)
  metadata            String?   @default("{}") // { productName, productId, deviceInfo, etc }
  
  createdAt           DateTime  @default(now())
  
  model               ARProductModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  
  @@index([modelId])
  @@index([userId])
  @@index([shared])
  @@index([capturedAt])
  @@map("ar_snapshots")
}

// ============================================
// STRIPE INTERNATIONAL CARDS INTEGRATION (Phase 1-B)
// For Export Orders - Multi-Currency Support
// ============================================

/// Stripe Transaction records for international card payments
model StripeTransaction {
  id                String    @id @default(cuid())
  
  // Stripe identifiers
  paymentIntentId   String    @unique
  chargeId          String?
  
  // Order references
  orderId           String   @unique
  userId            String
  
  // Amount details (using Float for SQLite compatibility)
  amount            Float     // Original amount in DZD
  originalCurrency  String    @default("DZD")
  targetCurrency    String                       // EUR, USD, GBP, etc.
  convertedAmount   Float                         // Converted amount in target currency (cents)
  exchangeRate      Float                         // Rate used for conversion
  
  // Fee breakdown
  stripeFee         Float     @default(0)
  netAmount         Float     @default(0)
  
  // Status (Stripe statuses)
  status            String    @default("REQUIRES_PAYMENT_METHOD")
  // REQUIRES_PAYMENT_METHOD | REQUIRES_CONFIRMATION | REQUIRES_ACTION 
  // PROCESSING | REQUIRES_CAPTURE | CANCELED | SUCCEEDED
  
  // Payment method info
  paymentMethodId   String?
  paymentMethodType String?   // card, ideal, sepa_debit, bancontact, etc.
  cardLast4         String?
  cardBrand         String?   // visa, mastercard, amex, etc.
  
  // Receipt & verification
  receiptUrl        String?
  failureReason     String?
  
  // Refund tracking
  refundedAt        DateTime?
  refundAmount      Float?
  refundId          String?
  refundReason      String?
  
  // Raw event data for audit
  rawEvent          Json?
  
  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  // Relations
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  order             Order     @relation(fields: [orderId], references: [id])
  
  // Indexes for queries
  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([paymentIntentId])
  @@index([targetCurrency])
  @@index([createdAt])
  @@map("stripe_transactions")
}

/// Stripe Customer records - links local users to Stripe customers
model StripeCustomer {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  stripeCustomerId        String   @unique
  
  // Customer preferences
  defaultPaymentMethodId String?
  email                   String
  name                    String?
  phone                   String?
  
  // Currency preference for this customer
  currency                String   @default("EUR")
  
  // Metadata
  metadata                String?  // JSON string for additional data
  
  // Timestamps
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  
  // Relations
  paymentMethods          StripePaymentMethod[]
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([stripeCustomerId])
  @@map("stripe_customers")
}

/// Saved Stripe Payment Methods for returning customers
model StripePaymentMethod {
  id                      String   @id @default(cuid())
  stripeCustomerId        String
  stripePaymentMethodId   String   @unique
  userId                  String
  
  // Payment method details
  type                    String   // card, sepa_debit, ideal, bancontact, etc.
  brand                   String?  // visa, mastercard, etc. (for cards)
  last4                   String?
  expMonth                Int?
  expYear                 Int?
  
  // Billing details (optional)
  billingName             String?
  billingEmail            String?
  billingCountry          String?
  
  // Status
  isDefault               Boolean  @default(false)
  isActive                Boolean  @default(true)
  
  // Timestamps
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  
  // Relations
  customer                StripeCustomer @relation(fields: [stripeCustomerId], references: [stripeCustomerId], onDelete: Cascade)
  
  @@index([stripeCustomerId])
  @@index([userId])
  @@index([type])
  @@map("stripe_payment_methods")
}

// ============================================
// WEBRTC VOICE/VIDEO CALLS (Phase 3-A)
// ============================================

enum CallType {
  AUDIO
  VIDEO
  SCREEN_SHARE
}

enum CallSessionStatus {
  INITIATING
  RINGING
  IN_PROGRESS
  ON_HOLD
  ENDED
  MISSED
  DECLINED
  FAILED
}

enum CallContextType {
  DIRECT
  ORDER_RELATED
  PRODUCT_QUESTION
  SUPPORT
}

/// Voice/Video call sessions for in-platform communication
model CallSession {
  id              String            @id @default(cuid())
  
  // Participants
  callerId        String
  calleeId        String
  callerName      String
  calleeName      String
  callerAvatar    String?
  calleeAvatar    String?
  
  // Room identifier for WebRTC signaling
  roomId          String            @unique
  
  // Call configuration
  callType        CallType
  status          CallSessionStatus @default(INITIATING)
  contextType     CallContextType   @default(DIRECT)
  contextId       String?           // Order ID, Product ID, etc.
  
  // Media quality settings
  mediaQuality    String            @default("HD") // SD, HD, FHD, UHD
  
  // Timestamps
  startedAt       DateTime          @default(now())
  connectedAt     DateTime?
  endedAt         DateTime?
  durationSeconds Int?              @default(0)
  
  // Recording
  isRecording     Boolean           @default(false)
  recordingUrl    String?
  hasScreenShare  Boolean           @default(false)
  
  // ICE servers configuration (JSON)
  iceServers      String?           // JSON string of ICE server configs
  
  // Transcription (AI)
  transcriptionEnabled Boolean     @default(false)
  transcriptionUrl      String?
  
  // Cost tracking (for premium features)
  isPremiumCall   Boolean           @default(false)
  costPerMinute   Float?
  totalCost       Float?            @default(0)
  
  // End reason
  endReason       String?           // User hung up, timeout, declined, etc.
  endedBy         String?           // User ID of who ended the call
  
  // Metadata (JSON for extensibility)
  metadata        String?           // JSON string
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  // Relations
  events          CallEvent[]
  
  // Indexes for efficient queries
  @@index([callerId])
  @@index([calleeId])
  @@index([status])
  @@index([callType])
  @@index([startedAt])
  @@index([roomId])
  @@map("call_sessions")
}

/// Events during a call session (for analytics and debugging)
model CallEvent {
  id              String   @id @default(cuid())
  callSessionId   String
  
  // Event type
  eventType       String   // ICE_CONNECTED, ICE_FAILED, QUALITY_CHANGE, 
                           // MUTED_TOGGLED, RECORDING_STARTED, SCREEN_SHARE_STARTED, etc.
  
  // Event data
  timestamp       DateTime @default(now())
  metadata        String?  // JSON string with event-specific data
  
  // Source
  userId          String?  // Which user triggered this event
  
  createdAt       DateTime @default(now())
  
  // Relations
  callSession     CallSession @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  
  // Indexes
  @@index([callSessionId])
  @@index([eventType])
  @@index([timestamp])
  @@map("call_events")
}

/// User call preferences and settings
model CallSettings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  
  // Default call settings
  defaultCallType     String   @default("VIDEO") // AUDIO or VIDEO
  defaultMediaQuality String   @default("HD")    // SD, HD, FHD, UHD
  enableAutoAnswer    Boolean  @default(false)
  autoAnswerDelay     Int?                      // Seconds before auto-answer
  
  // Device preferences
  preferredCamera     String?  // Device ID
  preferredMicrophone String?  // Device ID
  preferredSpeaker    String?  // Device ID
  
  // Privacy settings
  allowCallsFrom      String   @default("EVERYONE") // EVERYONE, CONTACTS, NOBODY
  showOnlineStatus    Boolean  @default(true)
  enableNotifications Boolean  @default(true)
  
  // Recording preferences
  autoRecordCalls     Boolean  @default(false)
  recordVideo         Boolean  @default(true)
  storeRecordings     Boolean  @default(true)
  
  // Quality preferences
  enableHDVideo       Boolean  @default(true)
  enableNoiseSuppression Boolean @default(true)
  enableEchoCancellation Boolean @default(true)
  
  // Metadata
  metadata            String?  // JSON string for additional settings
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  @@map("call_settings")
}
