// AlgeriaTrade B2B Marketplace - Database Schema
// Designed for Algerian market with multilingual support

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  BUYER
  SUPPLIER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  firstName     String
  lastName      String
  phone         String?
  avatar        String?
  role          UserRole @default(BUYER)
  isActive      Boolean  @default(true)
  emailVerified Boolean  @default(false)
  lastLoginAt   DateTime?
  lastLoginIp   String?
  
  // Relations
  company       Company?
  reviews      Review[]
  reviewVotes  ReviewVote[]
  favorites    Favorite[]
  notifications Notification[]
  emailLogs    EmailLog[] @relation("UserEmailLogs")
  emailPreference EmailPreference?
  messagesSent  Message[] @relation("MessageFrom")
  messagesReceived Message[] @relation("MessageTo")
  conversationParticipants ConversationParticipant[]
  ordersPlaced Order[] @relation("BuyerOrders")
  rfqsCreated  RFQ[] @relation("BuyerRFQs")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Company {
  id                  String             @id @default(cuid())
  name                String
  slug                String             @unique
  legalForm           String             // SARL, EURL, SPA, SNC
  rcNumber            String             // Registre de Commerce
  nif                 String             // Numéro d'Identification Fiscale
  nis                 String             // Numéro d'Identification Statistique
  website             String?
  description         String?
  logo                String?
  coverImage          String?
  yearEstablished     Int?
  employeeCount       Int?
  productionCapacity  String?
  exportCapability    Boolean            @default(false)
  verificationStatus  VerificationStatus  @default(PENDING)
  rating              Float              @default(0)
  reviewCount         Int                @default(0)
  responseRate        Float              @default(0)
  
  // Location
  wilaya              String
  commune             String?
  address             String?
  
  // Contact
  contactEmail        String
  contactPhone        String
  
  isVerified          Boolean            @default(false)
  isActive            Boolean            @default(true)
  
  // Relations
  userId              String             @unique
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  products            Product[]
  ordersReceived      Order[] @relation("SupplierOrders")
  quotations          Quotation[]
  companyReviews      Review[] @relation("CompanyReviews")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companies")
}

// ============================================
// PRODUCT CATALOG
// ============================================

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?
  image       String?
  icon        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id])
  subcategories Category[] @relation("CategoryTree")
  products    Product[]
  rfqs        RFQ[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Product {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  sku                 String?  @unique
  shortDescription    String?
  description         String?
  
  // Pricing
  price               Float?
  priceRangeMin       Float?
  priceRangeMax       Float?
  currency            String   @default("DZD")
  negotiablePrice     Boolean  @default(false)
  
  // Inventory
  moq                 Int?
  unit                String?
  availability        String   @default("in_stock")
  
  // Production
  leadTime            String?
  
  // Origin
  countryOfOrigin     String?
  
  // Relations
  companyId           String
  categoryId          String
  
  company             Company  @relation(fields: [companyId], references: [id])
  category            Category @relation(fields: [categoryId], references: [id])
  
  images              ProductImage[]
  favorites           Favorite[] @relation("ProductFavorites")
  reviews             Review[] @relation("ProductReviews")
  orderItems          OrderItem[]
  
  viewCount           Int      @default(0)
  status              String   @default("draft")
  isFeatured          Boolean  @default(false)
  isActive            Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([companyId])
  @@map("products")
}

model ProductImage {
  id          String @id @default(cuid())
  productId   String
  url         String
  alt         String?
  sortOrder   Int      @default(0)
  isPrimary   Boolean  @default(false)

  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// ============================================
// RFQ (REQUEST FOR QUOTATION) SYSTEM
// ============================================

enum RFQStatus {
  DRAFT
  PUBLISHED
  QUOTATIONS_RECEIVED
  NEGOTIATION
  AWARDED
  CLOSED
  CANCELLED
}

model RFQ {
  id                  String    @id @default(cuid())
  title               String
  description         String?
  quantity            Int
  unit                String?
  targetPrice         Float?
  targetCurrency      String    @default("DZD")
  deliveryLocation     String?
  requiredDeliveryDate DateTime?
  expirationDate      DateTime?
  
  // Relations
  buyerId             String
  categoryId          String?
  
  buyer               User     @relation("BuyerRFQs", fields: [buyerId], references: [id])
  category            Category? @relation(fields: [categoryId], references: [id])
  quotations          Quotation[]
  
  status              RFQStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerId])
  @@map("rfqs")
}

// ============================================
// QUOTATION SYSTEM
// ============================================

enum QuotationStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quotation {
  id          String         @id @default(cuid())
  rfqId       String
  companyId   String
  totalPrice  Float
  currency    String         @default("DZD")
  notes       String?
  validUntil  DateTime?

  rfq         RFQ            @relation(fields: [rfqId], references: [id])
  company     Company        @relation(fields: [companyId], references: [id])
  items       QuotationItem[]

  status      QuotationStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rfqId])
  @@index([companyId])
  @@map("quotations")
}

model QuotationItem {
  id          String @id @default(cuid())
  quotationId String
  productName String
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  unit        String?

  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_items")
}

// ============================================
// MESSAGING SYSTEM
// ============================================

model Conversation {
  id          String   @id @default(cuid())
  type        String   @default("direct")

  participants ConversationParticipant[]
  messages    Message[]

  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("conversations")
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt       DateTime @default(now())

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id          String   @id @default(cuid())
  conversationId String
  fromUserId  String
  toUserId    String
  content     String?
  fileType    String?
  fileUrl     String?
  fileName    String?
  isRead      Boolean  @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  fromUser    User     @relation("MessageFrom", fields: [fromUserId], references: [id])
  toUser      User     @relation("MessageTo", fields: [toUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@map("messages")
}

// ============================================
// ORDER MANAGEMENT
// ============================================

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  COMPLETED
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  buyerId         String
  companyId       String
  subtotal        Float
  taxAmount       Float       @default(0)
  shippingCost    Float       @default(0)
  totalAmount     Float
  currency        String      @default("DZD")
  notes           String?
  
  deliveryName    String
  deliveryPhone   String
  deliveryAddress String
  deliveryWilaya  String
  
  buyer           User       @relation("BuyerOrders", fields: [buyerId], references: [id])
  company         Company     @relation("SupplierOrders", fields: [companyId], references: [id])
  items           OrderItem[]
  payment         Payment?
  
  status          OrderStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerId])
  @@index([companyId])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  productName String
  quantity    Int
  unitPrice   Float
  totalPrice  Float

  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// ============================================
// REVIEWS & RATINGS SYSTEM
// ============================================

model Review {
  id            String   @id @default(cuid())
  
  // Relations
  productId     String?  // For product reviews
  companyId     String?  // For company reviews
  orderId       String?  // If verified purchase
  reviewerId    String
  
  // Content
  rating        Int      // 1-5 (can be stored as int, display as half-stars)
  title         String?
  comment       String?
  pros          String?  // JSON array ["Good quality", "Fast delivery"]
  cons          String?  // JSON array ["Expensive", "Late shipping"]
  
  // Company review categories (JSON object)
  categoryRatings String? // {"quality": 5, "communication": 4, "delivery": 3, "value": 4, "afterSales": 5}
  
  // Media
  images        String?  // JSON array of image URLs
  
  // Metadata
  isVerifiedPurchase Boolean @default(false)
  isAnonymous   Boolean  @default(false)
  isFeatured    Boolean  @default(false)
  
  // Voting
  helpfulCount  Int      @default(0)
  notHelpfulCount Int    @default(0)
  
  // Status & Moderation
  status        String   @default("published") // published, pending, rejected, hidden, flagged
  reportedAt    DateTime?
  reportReason  String?
  moderatedBy   String?
  moderatedAt   DateTime?
  
  // Response (from supplier)
  response      String?
  respondedAt   DateTime?
  respondedBy   String?  // Company userId
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  product       Product? @relation("ProductReviews", fields: [productId], references: [id])
  company       Company? @relation("CompanyReviews", fields: [companyId], references: [id])
  reviewer      User     @relation(fields: [reviewerId], references: [id])
  votes         ReviewVote[]
  
  @@index([productId])
  @@index([companyId])
  @@index([reviewerId])
  @@index([status])
  @@map("reviews")
}

model ReviewVote {
  id          String   @id @default(cuid())
  reviewId    String
  userId      String
  type        String   // "helpful" | "not_helpful"
  
  review      Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@unique([reviewId, userId, type])
  @@map("review_votes")
}

// ============================================
// FAVORITES
// ============================================

enum FavoriteType {
  PRODUCT
  SUPPLIER
  RFQ
}

model Favorite {
  id          String       @id @default(cuid())
  userId      String
  itemType    FavoriteType
  itemId      String

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product?     @relation("ProductFavorites", fields: [itemId], references: [id])

  @@unique([userId, itemType, itemId])
  @@map("favorites")
}

// ============================================
// NOTIFICATIONS (Enhanced)
// ============================================

enum NotificationCategory {
  AUTH           // Email verify, password reset
  RFQ            // New quotation, RFQ awarded
  ORDER          // Order updates
  MESSAGE        // New message
  SYSTEM         // Platform announcements
  MARKETING      // Promotions
}

enum NotificationType {
  // Auth notifications
  EMAIL_VERIFICATION_REQUIRED
  EMAIL_VERIFIED
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_SUCCESS
  LOGIN_ALERT
  
  // RFQ notifications
  NEW_RFQ_RECEIVED
  NEW_QUOTATION_RECEIVED
  QUOTATION_ACCEPTED
  QUOTATION_REJECTED
  RFQ_AWARDED
  RFQ_EXPIRED
  
  // Order notifications
  ORDER_CONFIRMED
  ORDER_PROCESSING
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  PAYMENT_RECEIVED
  REFUND_PROCESSED
  
  // Message notifications
  NEW_MESSAGE
  MESSAGE_MENTIONED
  
  // System notifications
  COMPANY_VERIFIED
  COMPANY_VERIFICATION_REJECTED
  ACCOUNT_INACTIVE_REMINDER
  WELCOME
  SYSTEM_ANNOUNCEMENT
  
  // Marketing notifications
  FEATURED_PRODUCT
  PROMOTION
  WEEKLY_DIGEST
  
  // Review notifications
  NEW_REVIEW
}

model Notification {
  id              String               @id @default(cuid())
  userId          String
  type            NotificationType
  category        NotificationCategory
  title           String
  message         String
  data            String?              // JSON string for additional data
  actionUrl       String?              // Link for CTA
  actionText      String?              // Text for CTA button
  isRead          Boolean              @default(false)
  readAt          DateTime?
  emailSent       Boolean              @default(false)
  emailSentAt     DateTime?

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt       DateTime            @default(now())

  @@index([userId, isRead])
  @@index([userId, category])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================
// EMAIL LOGS & PREFERENCES
// ============================================

enum EmailType {
  WELCOME_BUYER
  WELCOME_SUPPLIER
  WELCOME_ADMIN
  EMAIL_VERIFICATION
  PASSWORD_RESET
  LOGIN_ALERT
  NEW_RFQ_NOTIFICATION
  QUOTATION_RECEIVED
  QUOTATION_ACCEPTED
  QUOTATION_REJECTED
  RFQ_AWARDED
  ORDER_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  PAYMENT_RECEIVED
  COMPANY_VERIFICATION_APPROVED
  COMPANY_VERIFICATION_REJECTED
  WEEKLY_DIGEST
  INACTIVE_REENGAGEMENT
  FEATURED_PRODUCT_PROMO
  PLATFORM_UPDATE
}

enum EmailStatus {
  PENDING
  SENT
  DELIVERED
  BOUNCED
  COMPLAINT
  FAILED
}

model EmailLog {
  id              String       @id @default(cuid())
  userId          String?
  emailType       EmailType
  toEmail         String
  subject         String
  status          EmailStatus   @default(PENDING)
  providerId      String?       // External ID from Resend/SendGrid
  errorMessage    String?
  sentAt          DateTime?
  deliveredAt     DateTime?
  bouncedAt       DateTime?

  user            User?        @relation("UserEmailLogs", fields: [userId], references: [id], onDelete: SetNull)

  createdAt       DateTime      @default(now())

  @@index([userId])
  @@index([status])
  @@index([emailType])
  @@map("email_logs")
}

model EmailPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  
  // Global preferences
  emailEnabled        Boolean  @default(true)
  marketingEmails     Boolean  @default(true)
  
  // Category-level preferences
  authEmails          Boolean  @default(true)
  rfqEmails           Boolean  @default(true)
  orderEmails         Boolean  @default(true)
  messageEmails       Boolean  @default(false)  // Default off - in-app only
  systemEmails        Boolean  @default(true)
  
  // Digest frequency (for non-critical emails)
  digestFrequency     String   @default("immediate")  // immediate, daily, weekly, off
  
  // Unsubscribe token for one-click unsubscribe
  unsubscribeToken    String   @unique @default(cuid())
  unsubscribedAt      DateTime?
  
  updatedAt           DateTime @updatedAt
  
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("email_preferences")
}

// ============================================
// PAYMENT SYSTEM - Algerian Payment Methods
// ============================================

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  PENDING_VERIFICATION
  CANCELLED
}

enum PaymentMethod {
  CIB           // Carte Interbancaire (Visa/Mastercard)
  CCP           // Chèque Postale
  BARIDIMOB     // Mobile Payment Algeria
  BANK_TRANSFER // Virement Bancaire
  COD           // Cash on Delivery
}

model Payment {
  id              String       @id @default(cuid())
  orderId         String       @unique
  amount          Float
  currency        String       @default("DZD")
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  
  // CIB fields
  cardLast4       String?
  cardType        String?      // "visa", "mastercard"
  transactionId   String?
  
  // CCP fields
  ccpReference    String?      // Format: CCP-YYYYMMDD-XXXXX
  ccpAccount      String?
  ccpHolderName   String?
  
  // BaridiMob fields
  phoneNumber     String?
  
  // Bank Transfer fields
  rib             String?
  bankName        String?
  receiptUrl      String?
  
  // COD fields
  deliveryWilaya  String?
  codFee          Float?       // Cash handling fee
  
  // Common fields
  referenceNumber String?      @unique // Unique payment reference
  notes           String?
  paidAt          DateTime?
  failureReason   String?
  metadata        String?      // JSON string for additional data
  
  order           Order        @relation(fields: [orderId], references: [id])
  logs            TransactionLog[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([method])
  @@index([referenceNumber])
  @@map("payments")
}

model TransactionLog {
  id          String   @id @default(cuid())
  paymentId   String?
  action      String   // created, processing, success, failure, refund, verified, rejected
  details     String?  // JSON string
  ipAddress   String?
  userAgent   String?
  userId      String?

  payment     Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@map("transaction_logs")
}

// ============================================
// ALGERIAN WILAYAS (Seed Data)
// ============================================

model Wilaya {
  id          String   @id @default(cuid())
  name        String
  nameAr      String
  code        String   @unique

  createdAt DateTime @default(now())

  @@map("wilayas")
}
