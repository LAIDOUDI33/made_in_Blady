// AlgeriaTrade B2B Marketplace - Database Schema
// Multi-Tenant White-Label System
// Designed for Algerian market with multilingual support

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// MULTI-TENANT SYSTEM
// ============================================

model Tenant {
  id                String   @id @default(cuid())
  slug              String   @unique  // algeriatrade, tunisiatrade, moroccotrade
  name              String   // Display name
  domain            String?  // Custom domain (optional)
  
  // Branding
  primaryColor      String   @default("#006233")
  secondaryColor    String   @default("#D52B1E")
  logoUrl           String?
  faviconUrl        String?
  backgroundImage   String?
  
  // Localization
  defaultLanguage   String   @default("fr")
  currency          String   @default("DZD")
  currencySymbol    String   @default("د.ج")
  locale            String   @default("fr-DZ")
  timezone          String   @default("Africa/Algiers")
  
  // Country config
  countryName       String   @default("Algérie")
  countryCode       String   @default("DZ")
  phonePrefix       String   @default("+213")
  
  // Features (license)
  features          String   @default("[\"catalog\",\"rfq\",\"messaging\",\"payments\",\"reviews\"]") // JSON array of enabled features
  
  // Status
  isActive          Boolean  @default(true)
  isPublic          Boolean  @default(true) // Visible in marketplace listing
  
  // Owner (if white-label client)
  ownerId           String?
  planType          String   @default("free") // free, professional, enterprise
  subscriptionEnd   DateTime?
  
  // Customization
  customCSS         String?
  customJS          String?
  footerText        String?
  contactEmail      String?
  contactPhone      String?
  
  // Social links
  websiteUrl        String?
  facebookUrl       String?
  linkedinUrl       String?
  twitterUrl        String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  users             User[]
  companies         Company[]
  
  @@map("tenants")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  BUYER
  SUPPLIER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  firstName     String
  lastName      String
  phone         String?
  avatar        String?
  role          UserRole @default(BUYER)
  isActive      Boolean  @default(true)
  emailVerified Boolean  @default(false)
  lastLoginAt   DateTime?
  lastLoginIp   String?
  
  // Multi-tenant
  tenantId      String
  
  // Relations
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  companies     Company[] @relation("UserCompanies")
  reviews      Review[]
  reviewVotes  ReviewVote[]
  favorites    Favorite[]
  notifications Notification[]
  emailLogs    EmailLog[] @relation("UserEmailLogs")
  emailPreference EmailPreference?
  messagesSent  Message[] @relation("MessageFrom")
  messagesReceived Message[] @relation("MessageTo")
  conversationParticipants ConversationParticipant[]
  ordersPlaced Order[] @relation("BuyerOrders")
  rfqsCreated  RFQ[] @relation("BuyerRFQs")
  
  // AI Features
  interactions UserInteraction[]
  recommendations Recommendation[]
  chatSessions  ChatSession[]
  
  // Security Relations
  twoFactorSecret TwoFactorSecret?
  twoFactorVerifications TwoFactorVerification[]
  userSessions UserSession[]
  passwordHistory PasswordHistory[]
  
  // API Marketplace Relations
  apiKeys        ApiKey[]       @relation("UserApiKeys")
  developerApps  DeveloperApp[] @relation("UserDeveloperApps")
  webhooks       Webhook[]      @relation("UserWebhooks")
  
  // Payment Methods (Phase 8B)
  savedPaymentMethods SavedPaymentMethod[]
  
  // Phase 1-B: Stripe International Cards
  stripeCustomer      StripeCustomer?
  stripeTransactions   StripeTransaction[]
  
  // Phase 8C: Crypto Payments
  cryptoPayments      CryptoPayment[]
  
  // SATIM/CIB Payment Gateway (Algeria)
  satimTransactions   SatimTransaction[]
  
  // Multi-Currency Support (Phase 1-F)
  currencyPreference  CurrencyPreference?
  conversionLogs      ConversionLog[] @relation("UserConversionLogs")
  
  // DPA Relations (Phase 1-D)
  dpAgreementsAsBuyer  DPAgreement[] @relation("DPABuyer")
  dpAgreementsAsSeller DPAgreement[] @relation("DPASeller")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("users")
}

model Company {
  id                  String             @id @default(cuid())
  name                String
  slug                String             @unique
  legalForm           String             // SARL, EURL, SPA, SNC
  rcNumber            String             // Registre de Commerce
  nif                 String             // Numéro d'Identification Fiscale
  nis                 String             // Numéro d'Identification Statistique
  website             String?
  description         String?
  logo                String?
  coverImage          String?
  yearEstablished     Int?
  employeeCount       Int?
  productionCapacity  String?
  exportCapability    Boolean            @default(false)
  verificationStatus  VerificationStatus  @default(PENDING)
  rating              Float              @default(0)
  reviewCount         Int                @default(0)
  responseRate        Float              @default(0)
  
  // Enhanced Verification (Phase 6A)
  verificationLevel   VerificationLevel   @default(BASIC)
  verifications       SupplierVerification[] @relation("CompanyVerifications")
  badges              CompanyBadge[]        @relation("CompanyBadges")
  
  // Multimedia (Phase 6C)
  videos              CompanyVideo[]       @relation("CompanyVideos")
  virtualTours        VirtualTour[]         @relation("VirtualTours")
  
  // Exhibitions (Phase 6F)
  booths              ExhibitionBooth[]     @relation("ExhibitionBooths")
  
  // Location
  wilaya              String
  commune             String?
  address             String?
  latitude            Float?   // GPS coordinates for map display
  longitude           Float?   // GPS coordinates for map display
  
  // Contact
  contactEmail        String
  contactPhone        String
  
  isVerified          Boolean            @default(false)
  isActive            Boolean            @default(true)
  
  // Multi-tenant
  tenantId            String
  
  // User relation (one-to-many: one user can have many companies)
  userId              String
  
  // Relations
  tenant              Tenant             @relation(fields: [tenantId], references: [id])
  user                User               @relation("UserCompanies", fields: [userId], references: [id], onDelete: Cascade)
  products            Product[]
  ordersReceived      Order[] @relation("SupplierOrders")
  quotations          Quotation[]
  companyReviews      Review[] @relation("CompanyReviews")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("companies")
}

// ============================================
// PRODUCT CATALOG
// ============================================

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?
  image       String?
  icon        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id])
  subcategories Category[] @relation("CategoryTree")
  products    Product[]
  rfqs        RFQ[]
  
  // Phase 6G: Insights & Guides
  marketInsights     MarketInsight[] @relation("MarketInsights")
  buyingGuides       BuyingGuide[] @relation("BuyingGuides")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Product {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  sku                 String?  @unique
  shortDescription    String?
  description         String?
  
  // Pricing
  price               Float?
  priceRangeMin       Float?
  priceRangeMax       Float?
  currency            String   @default("DZD")
  negotiablePrice     Boolean  @default(false)
  
  // Inventory
  moq                 Int?
  unit                String?
  availability        String   @default("in_stock")
  
  // Production
  leadTime            String?
  
  // Origin
  countryOfOrigin     String?
  
  // Phase 6D: Advanced Features
  certifications      ProductCertification[]   @relation("ProductCertifications")
  bulkPricingTiers    BulkPricingTier[]         @relation("BulkPricingTiers")
  customizationOptions CustomizationOption[]     @relation("CustomizationOptions")
  packageItems        PackageItem[]             @relation("PackageItems")
  relatedProductsFrom RelatedProduct[]           @relation("RelatedProductsFrom")
  relatedProductsTo   RelatedProduct[]           @relation("RelatedProductsTo")
  
  // Phase 6C: Video
  videos              ProductVideo[]            @relation("ProductVideos")
  
  // Phase 6G: Trending
  trendingRecords      TrendingProduct[]        @relation("TrendingProducts")
  
  // Relations
  companyId           String
  categoryId          String
  
  company             Company  @relation(fields: [companyId], references: [id])
  category            Category @relation(fields: [categoryId], references: [id])
  
  images              ProductImage[]
  favorites           Favorite[] @relation("ProductFavorites")
  reviews             Review[] @relation("ProductReviews")
  orderItems          OrderItem[]
  negotiations        Negotiation[] @relation("ProductNegotiations")
  
  viewCount           Int      @default(0)
  status              String   @default("draft")
  isFeatured          Boolean  @default(false)
  isActive            Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([companyId])
  @@map("products")
}

model ProductImage {
  id          String @id @default(cuid())
  productId   String
  url         String
  alt         String?
  sortOrder   Int      @default(0)
  isPrimary   Boolean  @default(false)

  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// ============================================
// RFQ (REQUEST FOR QUOTATION) SYSTEM
// ============================================

enum RFQStatus {
  DRAFT
  PUBLISHED
  QUOTATIONS_RECEIVED
  NEGOTIATION
  AWARDED
  CLOSED
  CANCELLED
}

model RFQ {
  id                  String    @id @default(cuid())
  title               String
  description         String?
  quantity            Int
  unit                String?
  targetPrice         Float?
  targetCurrency      String    @default("DZD")
  deliveryLocation     String?
  requiredDeliveryDate DateTime?
  expirationDate      DateTime?
  
  // Relations
  buyerId             String
  categoryId          String?
  
  buyer               User     @relation("BuyerRFQs", fields: [buyerId], references: [id])
  category            Category? @relation(fields: [categoryId], references: [id])
  quotations          Quotation[]
  
  status              RFQStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerId])
  @@map("rfqs")
}

// ============================================
// QUOTATION SYSTEM
// ============================================

enum QuotationStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quotation {
  id          String         @id @default(cuid())
  rfqId       String
  companyId   String
  totalPrice  Float
  currency    String         @default("DZD")
  notes       String?
  validUntil  DateTime?

  rfq         RFQ            @relation(fields: [rfqId], references: [id])
  company     Company        @relation(fields: [companyId], references: [id])
  items       QuotationItem[]

  status      QuotationStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rfqId])
  @@index([companyId])
  @@map("quotations")
}

model QuotationItem {
  id          String @id @default(cuid())
  quotationId String
  productName String
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  unit        String?

  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_items")
}

// ============================================
// MESSAGING SYSTEM
// ============================================

model Conversation {
  id          String   @id @default(cuid())
  type        String   @default("direct")

  participants ConversationParticipant[]
  messages    Message[]

  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("conversations")
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt       DateTime @default(now())

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id          String   @id @default(cuid())
  conversationId String
  fromUserId  String
  toUserId    String
  content     String?
  fileType    String?
  fileUrl     String?
  fileName    String?
  isRead      Boolean  @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  fromUser    User     @relation("MessageFrom", fields: [fromUserId], references: [id])
  toUser      User     @relation("MessageTo", fields: [toUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@map("messages")
}

// ============================================
// ORDER MANAGEMENT
// ============================================

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  COMPLETED
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  buyerId         String
  companyId       String
  subtotal        Float
  taxAmount       Float       @default(0)
  shippingCost    Float       @default(0)
  totalAmount     Float
  currency        String      @default("DZD")
  notes           String?
  
  deliveryName    String
  deliveryPhone   String
  deliveryAddress String
  deliveryWilaya  String
  
  buyer           User       @relation("BuyerOrders", fields: [buyerId], references: [id])
  company         Company     @relation("SupplierOrders", fields: [companyId], references: [id])
  items           OrderItem[]
  payment         Payment?
  
  // Phase 8C: Crypto Payment
  cryptoPayment   CryptoPayment?
  
  // Phase 6B: Trade Assurance
  escrow           EscrowAccount?
  
  // Phase 6H: Logistics
  shipments        Shipment[] @relation("OrderShipments")
  
  // Phase 8I: Negotiations
  negotiations     Negotiation[] @relation("OrderNegotiations")
  
  // Phase 1-D: DPA Agreements
  dpaAgreement     DPAgreement?
  
  // Phase 1-B: Stripe International Cards
  stripeTransaction StripeTransaction?
  
  // SATIM/CIB Payment Gateway (Algeria)
  satimTransactions  SatimTransaction[] @relation("OrderSatimTransactions")
  
  status          OrderStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerId])
  @@index([companyId])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  productName String
  quantity    Int
  unitPrice   Float
  totalPrice  Float

  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// ============================================
// REVIEWS & RATINGS SYSTEM
// ============================================

model Review {
  id            String   @id @default(cuid())
  
  // Relations
  productId     String?  // For product reviews
  companyId     String?  // For company reviews
  orderId       String?  // If verified purchase
  reviewerId    String
  
  // Content
  rating        Int      // 1-5 (can be stored as int, display as half-stars)
  title         String?
  comment       String?
  pros          String?  // JSON array ["Good quality", "Fast delivery"]
  cons          String?  // JSON array ["Expensive", "Late shipping"]
  
  // Company review categories (JSON object)
  categoryRatings String? // {"quality": 5, "communication": 4, "delivery": 3, "value": 4, "afterSales": 5}
  
  // Media
  images        String?  // JSON array of image URLs
  
  // Metadata
  isVerifiedPurchase Boolean @default(false)
  isAnonymous   Boolean  @default(false)
  isFeatured    Boolean  @default(false)
  
  // Voting
  helpfulCount  Int      @default(0)
  notHelpfulCount Int    @default(0)
  
  // Status & Moderation
  status        String   @default("published") // published, pending, rejected, hidden, flagged
  reportedAt    DateTime?
  reportReason  String?
  moderatedBy   String?
  moderatedAt   DateTime?
  
  // Response (from supplier)
  response      String?
  respondedAt   DateTime?
  respondedBy   String?  // Company userId
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  product       Product? @relation("ProductReviews", fields: [productId], references: [id])
  company       Company? @relation("CompanyReviews", fields: [companyId], references: [id])
  reviewer      User     @relation(fields: [reviewerId], references: [id])
  votes         ReviewVote[]
  
  @@index([productId])
  @@index([companyId])
  @@index([reviewerId])
  @@index([status])
  @@map("reviews")
}

model ReviewVote {
  id          String   @id @default(cuid())
  reviewId    String
  userId      String
  type        String   // "helpful" | "not_helpful"
  
  review      Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@unique([reviewId, userId, type])
  @@map("review_votes")
}

// ============================================
// FAVORITES
// ============================================

enum FavoriteType {
  PRODUCT
  SUPPLIER
  RFQ
}

model Favorite {
  id          String       @id @default(cuid())
  userId      String
  itemType    FavoriteType
  itemId      String

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product?     @relation("ProductFavorites", fields: [itemId], references: [id])

  @@unique([userId, itemType, itemId])
  @@map("favorites")
}

// ============================================
// NOTIFICATIONS (Enhanced)
// ============================================

enum NotificationCategory {
  AUTH           // Email verify, password reset
  RFQ            // New quotation, RFQ awarded
  ORDER          // Order updates
  MESSAGE        // New message
  SYSTEM         // Platform announcements
  MARKETING      // Promotions
}

enum NotificationType {
  // Auth notifications
  EMAIL_VERIFICATION_REQUIRED
  EMAIL_VERIFIED
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_SUCCESS
  LOGIN_ALERT
  
  // RFQ notifications
  NEW_RFQ_RECEIVED
  NEW_QUOTATION_RECEIVED
  QUOTATION_ACCEPTED
  QUOTATION_REJECTED
  RFQ_AWARDED
  RFQ_EXPIRED
  
  // Order notifications
  ORDER_CONFIRMED
  ORDER_PROCESSING
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  PAYMENT_RECEIVED
  REFUND_PROCESSED
  
  // Message notifications
  NEW_MESSAGE
  MESSAGE_MENTIONED
  
  // System notifications
  COMPANY_VERIFIED
  COMPANY_VERIFICATION_REJECTED
  ACCOUNT_INACTIVE_REMINDER
  WELCOME
  SYSTEM_ANNOUNCEMENT
  
  // Marketing notifications
  FEATURED_PRODUCT
  PROMOTION
  WEEKLY_DIGEST
  
  // Review notifications
  NEW_REVIEW
}

model Notification {
  id              String               @id @default(cuid())
  userId          String
  type            NotificationType
  category        NotificationCategory
  title           String
  message         String
  data            String?              // JSON string for additional data
  actionUrl       String?              // Link for CTA
  actionText      String?              // Text for CTA button
  isRead          Boolean              @default(false)
  readAt          DateTime?
  emailSent       Boolean              @default(false)
  emailSentAt     DateTime?

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt       DateTime            @default(now())

  @@index([userId, isRead])
  @@index([userId, category])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================
// EMAIL LOGS & PREFERENCES
// ============================================

enum EmailType {
  WELCOME_BUYER
  WELCOME_SUPPLIER
  WELCOME_ADMIN
  EMAIL_VERIFICATION
  PASSWORD_RESET
  LOGIN_ALERT
  NEW_RFQ_NOTIFICATION
  QUOTATION_RECEIVED
  QUOTATION_ACCEPTED
  QUOTATION_REJECTED
  RFQ_AWARDED
  ORDER_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  PAYMENT_RECEIVED
  COMPANY_VERIFICATION_APPROVED
  COMPANY_VERIFICATION_REJECTED
  WEEKLY_DIGEST
  INACTIVE_REENGAGEMENT
  FEATURED_PRODUCT_PROMO
  PLATFORM_UPDATE
}

enum EmailStatus {
  PENDING
  SENT
  DELIVERED
  BOUNCED
  COMPLAINT
  FAILED
}

model EmailLog {
  id              String       @id @default(cuid())
  userId          String?
  emailType       EmailType
  toEmail         String
  subject         String
  status          EmailStatus   @default(PENDING)
  providerId      String?       // External ID from Resend/SendGrid
  errorMessage    String?
  sentAt          DateTime?
  deliveredAt     DateTime?
  bouncedAt       DateTime?

  user            User?        @relation("UserEmailLogs", fields: [userId], references: [id], onDelete: SetNull)

  createdAt       DateTime      @default(now())

  @@index([userId])
  @@index([status])
  @@index([emailType])
  @@map("email_logs")
}

model EmailPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  
  // Global preferences
  emailEnabled        Boolean  @default(true)
  marketingEmails     Boolean  @default(true)
  
  // Category-level preferences
  authEmails          Boolean  @default(true)
  rfqEmails           Boolean  @default(true)
  orderEmails         Boolean  @default(true)
  messageEmails       Boolean  @default(false)  // Default off - in-app only
  systemEmails        Boolean  @default(true)
  
  // Digest frequency (for non-critical emails)
  digestFrequency     String   @default("immediate")  // immediate, daily, weekly, off
  
  // Unsubscribe token for one-click unsubscribe
  unsubscribeToken    String   @unique @default(cuid())
  unsubscribedAt      DateTime?
  
  updatedAt           DateTime @updatedAt
  
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("email_preferences")
}

// ============================================
// PAYMENT SYSTEM - Algerian Payment Methods
// ============================================

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  PENDING_VERIFICATION
  CANCELLED
}

enum PaymentMethod {
  CIB           // Carte Interbancaire (Visa/Mastercard) - via SATIM
  CCP           // Chèque Postale
  BARIDIMOB     // Mobile Payment Algeria
  BANK_TRANSFER // Virement Bancaire
  COD           // Cash on Delivery
  SATIM         // SATIM/CIB Official Gateway
  STRIPE        // Stripe International Cards
}

model Payment {
  id              String       @id @default(cuid())
  orderId         String       @unique
  amount          Float
  currency        String       @default("DZD")
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  
  // CIB fields
  cardLast4       String?
  cardType        String?      // "visa", "mastercard"
  transactionId   String?
  
  // External Gateway IDs (Phase 8A/8B)
  satimTransactionId     String?   // SATIM transaction reference
  stripePaymentIntentId  String?   // Stripe Payment Intent ID
  stripeClientSecret     String?   // Stripe client secret (temporary)
  
  // CCP fields
  ccpReference    String?      // Format: CCP-YYYYMMDD-XXXXX
  ccpAccount      String?
  ccpHolderName   String?
  
  // BaridiMob fields
  phoneNumber     String?
  
  // Bank Transfer fields
  rib             String?
  bankName        String?
  receiptUrl      String?
  
  // COD fields
  deliveryWilaya  String?
  codFee          Float?       // Cash handling fee
  
  // Common fields
  referenceNumber String?      @unique // Unique payment reference
  notes           String?
  paidAt          DateTime?
  failureReason   String?
  metadata        String?      // JSON string for additional data
  
  order           Order        @relation(fields: [orderId], references: [id])
  logs            TransactionLog[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([method])
  @@index([referenceNumber])
  @@map("payments")
}

model TransactionLog {
  id          String   @id @default(cuid())
  paymentId   String?
  action      String   // created, processing, success, failure, refund, verified, rejected
  details     String?  // JSON string
  ipAddress   String?
  userAgent   String?
  userId      String?

  payment     Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@map("transaction_logs")
}

// ============================================
// SATIM TRANSACTION LOGS (CIB Payment Gateway)
// ============================================

/// SATIM (Système Algérien de Télécompensation Interbancaire et Monétique)
/// Official CIB payment gateway transaction records for Algeria
/// Tracks all SATIM payment sessions, status changes, and responses
model SatimTransaction {
  /// Unique internal ID
  id              String   @id @default(cuid())
  
  /// SATIM transaction reference (unique from gateway)
  transactionId   String   @unique
  
  /// Internal order ID
  orderId         String?
  
  /// User who initiated the payment
  userId          String
  
  /// Payment amount in DZD
  amount          Float
  
  /// Currency code (always DZD for SATIM)
  currency        String   @default("DZD")
  
  /// Current transaction status
  status          String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, CANCELLED, REFUNDED
  
  /// Detected card type (VISA, MASTERCARD, CIB)
  cardType        String?
  
  /// Last 4 digits of card number
  cardLast4       String?
  
  /// Authorization code from bank
  authCode        String?
  
  /// Retrieval Reference Number for bank reconciliation
  rrn            String?
  
  /// Whether 3D Secure was used
  threeDSecure    Boolean  @default(false)
  
  /// DPA installment plan identifier (if applicable)
  installmentPlan String?
  
  /// Full SATIM response as JSON
  rawResponse     Json?
  
  /// Error message if failed
  errorMessage    String?
  
  /// Creation timestamp
  createdAt       DateTime @default(now())
  
  /// Last update timestamp
  updatedAt       DateTime @updatedAt
  
  /// Relations
  user            User     @relation(fields: [userId], references: [id])
  orders          Order[]  @relation("OrderSatimTransactions")
  
  /// Indexes for efficient queries
  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@index([transactionId])
  
  @@map("satim_transactions")
}

// ============================================
// WEBHOOK EVENT LOGS (Phase 8A/8B)
// ============================================

model WebhookEventLog {
  id              String       @id @default(cuid())
  
  // Source gateway
  gateway         String       // "SATIM" or "STRIPE"
  eventType       String       // e.g., "payment_intent.succeeded", "PAYMENT_SUCCESS"
  
  // Event data
  eventId         String?      // External event ID (Stripe event ID, etc.)
  payload         String?      // Full payload as JSON
  
  // Processing status
  processed       Boolean      @default(false)
  success         Boolean      @default(false)
  errorMessage    String?
  
  // Related entities
  paymentId       String?
  orderId         String?
  
  // Request info
  ipAddress       String?
  signatureValid  Boolean      @default(false) // Whether webhook signature was valid

  createdAt DateTime @default(now())

  @@index([gateway])
  @@index([eventType])
  @@index([paymentId])
  @@index([createdAt])
  @@map("webhook_event_logs")
}

// ============================================
// SAVED PAYMENT METHODS (Phase 8B - Future Use)
// ============================================

model SavedPaymentMethod {
  id              String       @id @default(cuid())
  userId          String
  
  // Payment method details
  gateway         String       // "STRIPE" or "SATIM"
  paymentMethodId String       // External ID (e.g., Stripe PM ID)
  cardLast4       String
  cardType        String       // "visa", "mastercard", "amex"
  cardBrand       String?      // Display name (e.g., "Visa ending in 4242")
  expiryMonth     Int
  expiryYear      Int
  
  // Billing details (optional)
  billingName     String?
  billingEmail    String?
  
  // Status
  isDefault       Boolean      @default(false)
  isActive        Boolean      @default(true)
  
  // Metadata
  metadata        String?      // JSON for additional data

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([gateway])
  @@index([isActive])
  @@map("saved_payment_methods")
}

// ============================================
