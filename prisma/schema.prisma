  messageId   String
  sessionId   String
  userId      String?
  
  rating      String   // "positive", "negative", "neutral"
  comment     String?
  category    String?  // "accuracy", "helpfulness", "clarity", "relevance"
  
  createdAt DateTime @default(now())
  
  @@index([messageId])
  @@index([sessionId])
  @@map("chat_feedback")
}

// ============================================
// API MARKETPLACE - Developer Portal System
// ============================================

model ApiKey {
  id            String    @id @default(cuid())
  key           String    @unique // SHA-256 hashed
  keyPrefix     String    @default("") // Display prefix like "at_xxxx..."
  name          String    // Human-readable name for the key
  permissions   String    @default("[]") // JSON array of ApiPermission strings
  rateLimit     Int       @default(100) // Requests per minute
  allowedIps    String?   // JSON array of allowed IP addresses (null = all)
  isActive      Boolean   @default(true)
  lastUsedAt    DateTime?
  ownerId       String
  expiresAt     DateTime?
  usageCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  owner         User      @relation("UserApiKeys", fields: [ownerId], references: [id], onDelete: Cascade)
  apps          DeveloperApp[]
  usageRecords  ApiUsageRecord[]
  
  @@index([ownerId])
  @@index([key])
  @@map("api_keys")
}

model DeveloperApp {
  id          String   @id @default(cuid())
  name        String
  description String?
  websiteUrl  String?  @map("website_url")
  callbackUrl String?  @map("callback_url")
  apiKeyId    String
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  owner       User     @relation("UserDeveloperApps", fields: [ownerId], references: [id], onDelete: Cascade)
  apiKey      ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  
  @@index([ownerId])
  @@index([apiKeyId])
  @@map("developer_apps")
}

model ApiUsageRecord {
  id           String   @id @default(cuid())
  apiKeyId     String
  endpoint     String
  method       String
  statusCode   Int
  responseTime Int // Response time in milliseconds
  ip           String
  userAgent    String?
  timestamp    DateTime @default(now())
  
  apiKey       ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  
  @@index([apiKeyId])
  @@index([timestamp])
  @@index([endpoint])
  @@map("api_usage_records")
}

model Webhook {
  id             String   @id @default(cuid())
  eventType      String   // WebhookEventType enum as string
  url            String   // Endpoint URL to receive webhook
  secret         String   // Secret for signature verification
  isActive       Boolean  @default(true)
  lastTriggeredAt DateTime?
  successCount   Int      @default(0)
  failureCount   Int      @default(0)
  ownerId        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  owner          User     @relation("UserWebhooks", fields: [ownerId], references: [id], onDelete: Cascade)
  
  @@index([ownerId])
  @@index([eventType])
  @@map("webhooks")
}

// ============================================
// PHASE 6A: SUPPLIER VERIFICATION & TRUST SYSTEM
// ============================================

enum VerificationLevel {
  BASIC           // Email & phone verified
  VERIFIED        // Business documents verified
  CERTIFIED       // On-site inspection passed
  PREMIUM         // SGS/TUV third-party audit
  ENTERPRISE      // Full enterprise verification
}

enum VerificationType {
  BUSINESS_LICENSE
  TAX_COMPLIANCE
  BANK_ACCOUNT
  IDENTITY
  ADDRESS
  PHONE
  EMAIL
  PRODUCT_QUALITY
  PRODUCTION_CAPACITY
  EXPORT_LICENSE
  ISO_CERTIFICATION
  SGS_AUDIT
  CUSTOM
}

model SupplierVerification {
  id                String            @id @default(cuid())
  companyId         String
  
  // Verification Level & Status
  level             VerificationLevel @default(BASIC)
  status            VerificationStatus @default(PENDING)
  
  // Verification Details
  type              VerificationType
  documents         String?            // JSON array of document URLs
  
  // Inspector Info (for on-site verification)
  inspectorName     String?
  inspectorId       String?
  inspectionDate    DateTime?
  inspectionNotes   String?
  inspectionPhotos  String?            // JSON array of photo URLs
  inspectionVideos  String?            // JSON array of video URLs
  
  // Scoring
  score             Int?               // 0-100 overall score
  categoryScores    String?            // JSON {"quality": 90, "capacity": 85, ...}
  
  // Validity
  issuedAt          DateTime?
  expiresAt         DateTime?
  isValid           Boolean            @default(false)
  
  // Admin Review
  reviewedBy        String?
  reviewedAt        DateTime?
  reviewNotes       String?
  rejectionReason   String?
  
  // Badge/Certificate
  badgeUrl          String?
  certificateUrl    String?
  certificateNumber String?            @unique
  
  company           Company?           @relation("CompanyVerifications", fields: [companyId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  
  @@index([companyId])
  @@index([level])
  @@index([status])
  @@index([certificateNumber])
  @@map("supplier_verifications")
}

model VerificationBadge {
  id                String            @id @default(cuid())
  name              String             // "Verified Supplier", "Premium Seller", etc.
  description       String?
  icon              String             // Badge icon URL or emoji
  color             String             @default("#006233") // Badge color
  level             VerificationLevel  // Minimum level required
  
  // Display Settings
  isDisplayed       Boolean            @default(true)
  sortOrder         Int                @default(0)
  
  companies         CompanyBadge[]
  
  createdAt         DateTime           @default(now())
  
  @@map("verification_badges")
}

model CompanyBadge {
  id                String   @id @default(cuid())
  companyId         String
  badgeId           String
  awardedAt         DateTime @default(now())
  expiresAt         DateTime?
  isActive          Boolean   @default(true)
  
  company           Company?           @relation("CompanyBadges", fields: [companyId], references: [id], onDelete: Cascade)
  badge             VerificationBadge @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  
  @@unique([companyId, badgeId])
  @@index([companyId])
  @@map("company_badges")
}

// ============================================
// PHASE 6B: TRADE ASSURANCE & ESCROW SYSTEM
// ============================================

enum EscrowStatus {
  PENDING
  FUNDED
  IN_ESCROW
  RELEASED
  REFUNDED
  PARTIAL_REFUND
  DISPUTED
  CANCELLED
}

enum DisputeStatus {
  OPEN
  INVESTIGATING
  MEDIATION
  ARBITRATION
  RESOLVED
  CANCELLED
}

enum DisputeReason {
  PRODUCT_NOT_AS_DESCRIBED
  QUALITY_ISSUES
  SHIPPING_DELAY
  WRONG_PRODUCT
  DAMAGED_GOODS
  PARTIAL_SHIPMENT
  SCAM_SUSPICION
  OTHER
}

model EscrowAccount {
  id                String       @id @default(cuid())
  accountId         String       @unique // Public account identifier
  orderId           String       @unique
  
  // Amounts
  amount            Float
  currency          String       @default("DZD")
  releasedAmount    Float         @default(0)
  refundedAmount    Float         @default(0)
  feeAmount         Float         @default(0) // Platform fee
  
  // Status
  status            EscrowStatus @default(PENDING)
  
  // Timeline
  fundedAt          DateTime?
  inEscrowAt        DateTime?
  releaseRequestedAt DateTime?
  releasedAt        DateTime?
  refundRequestedAt  DateTime?
  refundedAt        DateTime?
  
  // Parties
  buyerId           String
  supplierCompanyId String
  
  // Dispute (if any)
  dispute           Dispute?
  
  // Release Conditions
  autoReleaseDays   Int          @default(30) // Auto-release after N days
  autoReleaseAt     DateTime?
  
  // Transaction Details
  paymentMethod     String?
  paymentReference  String?
  
  order             Order        @relation(fields: [orderId], references: [id])
  
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  
  @@index([orderId])
  @@index([status])
  @@index([buyerId])
  @@map("escrow_accounts")
}

model Dispute {
  id                String         @id @default(cuid())
  escrowId          String         @unique
  
  // Dispute Details
  title             String
  description       String
  reason            DisputeReason
  status            DisputeStatus @default(OPEN)
  
  // Amount Requested
  requestedAmount   Float?
  offeredAmount     Float?
  settledAmount     Float?
  
  // Parties
  openedBy          String         // User ID who opened dispute
  buyerId           String
  supplierCompanyId String
  
  // Evidence
  evidence          String?        // JSON array of evidence URLs {type, url, description}
  
  // Resolution
  resolution        String?        // Resolution text
  resolvedBy        String?        // Admin/Mediator ID
  resolvedAt        DateTime?
  rulingInFavorOf   String?        // "buyer" or "supplier"
  
  // Mediation/Arbitration
  mediatorId        String?
  mediatorAssignedAt DateTime?
  arbitrationId    String?
  
  // Timeline
  responseDeadline  DateTime?
  escalationAt      DateTime?
  
  escrow            EscrowAccount  @relation(fields: [escrowId], references: [id], onDelete: Cascade)
  messages          DisputeMessage[]
  
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  
  @@index([status])
  @@index([buyerId])
  @@index([openedBy])
  @@map("disputes")
}

model DisputeMessage {
  id                String   @id @default(cuid())
  disputeId         String
  senderId          String
  senderRole        String   // "buyer", "supplier", "mediator", "admin"
  content           String
  attachments       String?  // JSON array of file URLs
  
  dispute           Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime @default(now())
  
  @@index([disputeId])
  @@map("dispute_messages")
}

// ============================================
// PHASE 6C: VIDEO SHOWROOM & MULTIMEDIA
// ============================================

model ProductVideo {
  id                String   @id @default(cuid())
  productId         String
  
  // Video Details
  title             String
  description       String?
  videoUrl          String   // Video file or embed URL
  thumbnailUrl      String?
  duration          Int?     // Duration in seconds
  
  // Video Type
