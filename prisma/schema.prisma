  @@index([viewCount])
  @@map("page_views")
}

// ============================================
// SECURITY - TWO-FACTOR AUTHENTICATION (2FA)
// ============================================

model TwoFactorSecret {
  id          String   @id @default(cuid())
  userId      String   @unique
  secret      String   // TOTP secret (encrypted)
