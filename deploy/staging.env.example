# =============================================================================
# Staging Environment Configuration - AlgeriaTrade.dz
# =============================================================================
#
# This configuration is for the STAGING environment.
# Staging is used for:
# - Pre-production testing
# - QA/Testing before production deployment
# - Feature validation with real-like data
# - Performance testing
#
# ⚠️  STAGING VS PRODUCTION DIFFERENCES  ⚠️
#
# 1. Different URLs (staging.algeriatrade.dz)
# 2. Separate database (no production data)
# 3. Test payment keys (sandbox mode)
# 4. Debug logging enabled
# 5. Relaxed security headers (for debugging)
# 6. Lower resource limits
#
# Usage:
#   cp staging.env.example .env.staging
#   # Edit .env.staging with staging values
#   docker compose --env-file .env.staging up -d
#
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------

# Staging environment
NODE_ENV=production

# Staging URL
NEXT_PUBLIC_APP_URL=https://staging.algeriatrade.dz

# Application name with staging indicator
NEXT_PUBLIC_APP_NAME=AlgeriaTrade [Staging]

# API URL for staging
NEXT_PUBLIC_API_URL=https://staging-api.algeriatrade.dz

# Socket.IO URL for staging
NEXT_PUBLIC_SOCKET_URL=wss://staging.algeriatrade.dz

# -----------------------------------------------------------------------------
# AUTHENTICATION (NextAuth.js)
# -----------------------------------------------------------------------------

# Staging auth URL
NEXTAUTH_URL=https://staging.algeriatrade.dz

# Staging secret (different from production!)
# GENERATE: openssl rand -base64 32
NEXTAUTH_SECRET=STAGING_CHANGE_ME_SECRET_KEY_HERE

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL) - SEPARATE FROM PRODUCTION
# -----------------------------------------------------------------------------

# Staging database connection string
DATABASE_URL=postgresql://algeriatrade_staging:STAGING_DB_PASSWORD@postgres:5432/algeriatrade_staging

# Database pool (smaller for staging)
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=5

# PostgreSQL credentials for staging
POSTGRES_USER=algeriatrade_staging
POSTGRES_PASSWORD=STAGING_DB_PASSWORD
POSTGRES_DB=algeriatrade_staging

# -----------------------------------------------------------------------------
# REDIS (Caching & Sessions) - SEPARATE FROM PRODUCTION
# -----------------------------------------------------------------------------

# Staging Redis (can use different database number on same instance)
REDIS_URL=redis://:STAGING_REDIS_PASSWORD@redis:6379/1

# Redis password
REDIS_PASSWORD=STAGING_REDIS_PASSWORD

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION
# -----------------------------------------------------------------------------

# Use test/sandbox email provider
EMAIL_PROVIDER=smtp

# Staging SMTP (or use a service like Mailtrap for testing)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525 or 587
SMTP_USER=YOUR_MAILTRAP_USERNAME
SMTP_PASS=YOUR_MAILTRAP_PASSWORD

# Staging sender (clearly marked as staging)
EMAIL_FROM=noreply@staging.algeriatrade.dz

# Resend (use test API key, not production)
RESEND_API_KEY=re_test_XXXXXX

# -----------------------------------------------------------------------------
# PAYMENT GATEWAYS - SANDBOX/TEST MODE
# -----------------------------------------------------------------------------

# IMPORTANT: Always use SANDBOX/TEST keys in staging!
# Never use production payment keys in staging!

# CIB Sandbox
CIB_API_KEY=sandbox_cib_test_key
CIB_MERCHANT_ID=test_merchant_id

# CCP Test
CCP_MERCHANT_ID=test_ccp_merchant_id

# BaridiMob Sandbox
BARIDIMOB_API_KEY=sandbox_baridimob_key
BARIDIMOB_WEBHOOK_SECRET=sandbox_webhook_secret

# SATIM Test
SATIM_TERMINAL_ID=test_terminal_id
SATIM_API_KEY=satim_test_key

# Stripe TEST MODE (not live!)
STRIPE_SECRET_KEY=sk_test_STRIPE_TEST_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_STRIPE_TEST_WEBHOOK
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_STRIPE_TEST_PUBLISHABLE

# Stripe Test Card Numbers:
# - Visa Success: 4242424242424242
# - Mastercard Success: 5555555555554444
# - Declined: 4000000000000002

# -----------------------------------------------------------------------------
# CLOUD STORAGE (S3-Compatible)
# -----------------------------------------------------------------------------

# Separate bucket for staging
S3_BUCKET=algeriatrade-staging-uploads

# Can use same region or different
S3_REGION=eu-west-3

# S3 Endpoint (optional, for MinIO etc.)
S3_ENDPOINT=

# AWS Credentials (use IAM user with limited permissions for staging)
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7STAGINGEXAMPLE
AWS_SECRET_ACCESS_KEY=stagingSecretKeyForStagingEnvOnly

# -----------------------------------------------------------------------------
# AI/ML SERVICES
# -----------------------------------------------------------------------------

# You can use same API keys (usage-based billing)
# Or separate projects for cost tracking
OPENAI_API_KEY=sk-OPENAI_KEY_OR_SAME_AS_PRODUCTION
ANTHROPIC_API_KEY=sk-ant-KEY_OR_SAME_AS_PRODUCTION

# -----------------------------------------------------------------------------
# MONITORING & OBSERVABILITY
# -----------------------------------------------------------------------------

# Separate Sentry project for staging (keeps errors isolated)
SENTRY_DSN=https://example@sentry.io/STAGING_PROJECT_ID

# Enable debug logging in staging
LOG_LEVEL=debug          # More verbose for troubleshooting
LOG_FORMAT=pretty        # Human-readable for development

# -----------------------------------------------------------------------------
# SECURITY (Relaxed for Staging)
# -----------------------------------------------------------------------------

# Staging encryption key (DIFFERENT from production!)
ENCRYPTION_KEY=STAGING_ENCRYPTION_KEY_CHANGE_ME

# CSRF Secret
CSRF_SECRET=STAGING_CSRF_SECRET_CHANGE_ME

# -----------------------------------------------------------------------------
# ADMIN TOOLS (Enabled in Staging)
# -----------------------------------------------------------------------------

# pgAdmin enabled for database inspection
PGADMIN_EMAIL=admin@staging.algeriatrade.dz
PGADMIN_PASSWORD=STAGING_PGADMIN_PASSWORD

# Redis Commander enabled
REDIS_COMMANDER_ENABLED=true

# -----------------------------------------------------------------------------
# FEATURE FLAGS (Test New Features in Staging First)
# -----------------------------------------------------------------------------

# Enable beta features for testing
ENABLE_BETA_FEATURES=true
ENABLE_NEW_UI=false
ENABLE_EXPERIMENTAL_AI=false

# -----------------------------------------------------------------------------
# RATE LIMITING (More Lenient in Staging)
# -----------------------------------------------------------------------------

# Higher limits for testing
API_RATE_LIMIT=200r/m
AUTH_RATE_LIMIT=20r/m
UPLOAD_RATE_LIMIT=30r/m

# =============================================================================
# STAGING-SPECIFIC NOTES
# =============================================================================

# Data Management:
# -----------------
# 1. Staging data can be reset frequently
# 2. Use seed data that mimics production but with fake PII
# 3. Consider auto-reset schedule (e.g., weekly)
# 4. No real customer data should ever be in staging

# Testing Checklist Before Production Deploy:
# -------------------------------------------
# [ ] All tests passing (unit, integration, e2e)
# [ ] Database migrations tested
# [ ] Payment flow tested with sandbox cards
# [ ] Email delivery verified (check spam folder)
# [ ] File uploads/downloads working
# [ ] Real-time features (WebSocket) functional
# [ ] Mobile responsive design verified
# [ ] Performance benchmarks acceptable
# [ ] Security headers validated
# [ ] SSL certificate valid
# [ ] Backup/restore procedure tested
# [ ] Rollback plan documented and tested

# Access Control:
# ---------------
# - Staging should be password protected OR
# - IP restricted to office/VPN IPs OR
# - Use basic auth via nginx
#
# Example nginx basic_auth for staging:
#   auth_basic "Staging - Authorized Access Only";
#   auth_basic_user_file /etc/nginx/.htpasswd-staging;
