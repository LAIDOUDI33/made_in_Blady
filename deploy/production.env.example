# =============================================================================
# Production Environment Configuration - AlgeriaTrade.dz
# =============================================================================
# 
# ⚠️  IMPORTANT SECURITY NOTICE  ⚠️
# 
# 1. NEVER commit this file with real secrets to version control!
# 2. Copy this file to .env and fill in your actual values
# 3. Use a secrets manager (HashiCorp Vault, AWS Secrets Manager) in production
# 4. Generate strong random values for all SECRET/KEY/PASSWORD fields
# 5. Rotate credentials regularly (every 90 days recommended)
#
# Usage:
#   cp production.env.example .env
#   # Edit .env with your values
#   docker compose --env-file .env up -d
#
# Generate secure random values:
#   openssl rand -base64 32    # For secrets/keys
#   openssl rand -hex 16       # For passwords/tokens
#
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------

# Node.js environment (must be "production")
NODE_ENV=production

# Public URL of the application (used for links, callbacks, etc.)
NEXT_PUBLIC_APP_URL=https://algeriatrade.dz

# Application display name
NEXT_PUBLIC_APP_NAME=AlgeriaTrade

# API URL (if using separate API domain)
NEXT_PUBLIC_API_URL=https://api.algeriatrade.dz

# Socket.IO URL for real-time features
NEXT_PUBLIC_SOCKET_URL=wss://algeriatrade.dz

# -----------------------------------------------------------------------------
# AUTHENTICATION (NextAuth.js)
# -----------------------------------------------------------------------------

# Base URL for authentication (must match NEXT_PUBLIC_APP_URL)
NEXTAUTH_URL=https://algeriatrade.dz

# Secret key for encrypting JWT tokens and session cookies
# GENERATE: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# -----------------------------------------------------------------------------

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://algeriatrade:CHANGE_ME_STRONG_PASSWORD@postgres:5432/algeriatrade

# Database connection pool settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# PostgreSQL credentials (for docker-compose)
POSTGRES_USER=algeriatrade
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=algeriatrade

# -----------------------------------------------------------------------------
# REDIS (Caching & Sessions)
# -----------------------------------------------------------------------------

# Redis connection URL
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379

# Redis password (for docker-compose)
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION
# -----------------------------------------------------------------------------

# Email provider: smtp | resend | sendgrid | mailgun
EMAIL_PROVIDER=smtp

# SMTP Configuration (for email_provider=smtp)
SMTP_HOST=smtp.algeriatrade.dz
SMTP_PORT=587
SMTP_USER=postmaster@algeriatrade.dz
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD

# Default sender address
EMAIL_FROM=noreply@algeriatrade.dz

# Resend API Key (for email_provider=resend)
RESEND_API_KEY=re_CHANGE_ME_API_KEY

# -----------------------------------------------------------------------------
# PAYMENT GATEWAYS - ALGERIAN
# -----------------------------------------------------------------------------

# CIB (Carte Internationale Bancaire) - Visa/Mastercard Algeria
CIB_API_KEY=cib_CHANGE_ME_API_KEY
CIB_MERCHANT_ID=CHANGE_ME_MERCHANT_ID

# CCP (Chèque Postal Algérien) - Bank Transfer
CCP_MERCHANT_ID=CHANGE_ME_CCP_MERCHANT_ID

# BaridiMob - Algerian Mobile Payment (CIB/EDAHABIA)
BARIDIMOB_API_KEY=baridimob_CHANGE_ME_API_KEY
BARIDIMOB_WEBHOOK_SECRET=baridimob_CHANGE_ME_WEBHOOK_SECRET

# SATIM - Algerian Payment Switch
SATIM_TERMINAL_ID=CHANGE_ME_SATIM_TERMINAL_ID
SATIM_API_KEY=satim_CHANGE_ME_API_KEY

# -----------------------------------------------------------------------------
# PAYMENT GATEWAYS - INTERNATIONAL
# -----------------------------------------------------------------------------

# Stripe (Credit/Debit Cards, Apple Pay, Google Pay)
STRIPE_SECRET_KEY=sk_live_CHANGE_ME_STRIPE_SECRET
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME_WEBHOOK_SECRET
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME_PUBLISHABLE

# -----------------------------------------------------------------------------
# CLOUD STORAGE (S3-Compatible)
# -----------------------------------------------------------------------------

# S3 Bucket name
S3_BUCKET=algeriatrade-uploads

# Region (eu-west-3 = Paris, good for Algeria latency)
S3_REGION=eu-west-3

# S3 Endpoint (use custom for MinIO or other S3-compatible storage)
# Leave empty for AWS S3
S3_ENDPOINT=

# AWS Credentials
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# -----------------------------------------------------------------------------
# AI/ML SERVICES
# -----------------------------------------------------------------------------

# OpenAI API (ChatGPT integration for AI assistant)
OPENAI_API_KEY=sk-OPENAI_CHANGE_ME_API_KEY

# Anthropic API (Claude AI for advanced features)
ANTHROPIC_API_KEY=sk-ant-ANTHROPIC_CHANGE_ME_API_KEY

# -----------------------------------------------------------------------------
# MONITORING & OBSERVABILITY
# -----------------------------------------------------------------------------

# Sentry DSN for error tracking
SENTRY_DSN=https://example@sentry.io/PROJECT_ID

# Logging configuration
LOG_LEVEL=info          # debug | info | warn | error
LOG_FORMAT=json         # json | pretty (use json in production)

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------

# Encryption key for sensitive data at rest
# GENERATE: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION_KEY

# CSRF Protection secret
CSRF_SECRET=CHANGE_ME_CSRF_SECRET

# -----------------------------------------------------------------------------
# ADMIN TOOLS (Optional - Disable in Production)
# -----------------------------------------------------------------------------

# pgAdmin (PostgreSQL Web UI)
PGADMIN_EMAIL=admin@algeriatrade.dz
PGADMIN_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD

# -----------------------------------------------------------------------------
# SSL/TLS CERTIFICATES
# -----------------------------------------------------------------------------
# Certificates are expected in ./certs/ directory:
# - fullchain.pem  (Full certificate chain)
# - privkey.pem    (Private key)
# - chain.pem      (Intermediate certificates)
#
# Generate with Let's Encrypt:
#   certbot certonly --webroot -w /var/www/certbot -d algeriatrade.dz -d www.algeriatrade.dz
# =============================================================================

# Additional notes:
# -------------------
# 1. For high-availability, consider using managed database services:
#    - AWS RDS / Aurora
#    - Google Cloud SQL
#    - Azure Database for PostgreSQL
#    - Supabase (PostgreSQL + Realtime)
#
# 2. For Redis in production, consider:
#    - AWS ElastiCache
#    - Redis Enterprise Cloud
#    - Upstash (Serverless Redis)
#
# 3. For file storage, consider:
#    - AWS S3 (with CloudFront CDN)
#    - Google Cloud Storage
#    - Azure Blob Storage
#    - MinIO (self-hosted S3-compatible)
#
# 4. For email in production, use transactional email services:
#    - Resend (recommended for simplicity)
#    - SendGrid
#    - Mailgun
#    - Amazon SES
#
# 5. Monitoring stack recommendations:
#    - Prometheus + Grafana (metrics & dashboards)
#    - Sentry (error tracking)
#    - LogRocket or FullStory (session replay)
#    - UptimeRobot or Pingdom (uptime monitoring)
