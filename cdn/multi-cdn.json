{"$schema": "https://json-schema.org/draft/2020-12/schema", "version": "1.0.0", "platform": "multi-cdn", "service_name": "AlgeriaTrade Multi-CDN Strategy", "description": "Multi-CDN configuration for AlgeriaTrade.dz with traffic distribution, failover, and cost optimization", "lastUpdated": "2024-12-01T00:00:00Z", "target_performance": {"algeria_primary": {"cities": ["Algiers", "Oran", "Constantine", "Batna", "Sétif", "Blida", "Béjaïa", "Tlemcen", "Chlef", "Annaba"], "target_latency_ms": 50, "priority": "critical"}, "mena_secondary": {"countries": ["Tunisia", "Morocco", "Libya", "Egypt", "Mauritania", "Togo"], "target_latency_ms": 100, "priority": "high"}, "europe_tertiary": {"countries": ["France", "Spain", "Italy", "Germany", "UK"], "target_latency_ms": 120, "priority": "standard"}, "global_default": {"regions": ["North America", "Asia Pacific", "South America", "Rest of World"], "target_latency_ms": 200, "priority": "standard"}}, "traffic_distribution": {"strategy": "weighted_round_robin_with_geo", "default_distribution": {"cloudflare": {"weight": 60, "role": "primary", "reason": "Best MENA coverage, strong DDoS protection"}, "fastly": {"weight": 25, "role": "secondary", "reason": "Excellent VCL flexibility, good European coverage"}, "cloudfront": {"weight": 15, "role": "tertiary", "reason": "AWS integration, backup for global coverage"}}, "geo_overrides": {"DZ": {"cloudflare": 80, "fastly": 15, "cloudfront": 5, "reason": "Cloudflare has best Algeria POP coverage"}, "TN": {"cloudflare": 70, "fastly": 25, "cloudfront": 5, "reason": "Balanced for Tunisia"}, "MA": {"cloudflare": 65, "fastly": 30, "cloudfront": 5, "reason": "Fastly has good Casablanca presence"}, "FR": {"cloudflare": 50, "fastly": 35, "cloudfront": 15, "reason": "All providers have excellent France coverage"}, "*": {"cloudflare": 60, "fastly": 25, "cloudfront": 15, "reason": "Default distribution"}}, "content_type_routing": {"static_assets": {"patterns": ["*.js", "*.css", "*.woff2", "*.woff", "*.ttf"