{"$schema": "https://json-schema.org/draft/2020-12/schema", "version": "1.0.0", "platform": "cloudflare", "zone": "algeriatrade.dz", "description": "Security Configuration for AlgeriaTrade.dz - WAF, Rate Limiting & Bot Protection", "lastUpdated": "2024-12-01T00:00:00Z", "security_level": "high", "configuration": {"waf": {"enabled": true, "mode": "on", "rulesets": [{"name": "Cloudflare Managed Ruleset", "id": "cloudflare_specials", "version": "latest", "enabled": true, "action": "managed", "rules": [{"id": "...5f180b9e...ec7c...", "description": "SQL Injection Detection", "group": "sqli", "enabled": true, "action": "block", "severity": "high", "exclusions": []}, {"id": "...e0a0d19e...3c8f...", "description": "Cross-Site Scripting (XSS) Detection", "group": "xss", "enabled": true, "action": "block", "severity": "high", "exclusions": []}, {"id": "...c142a5eb...8f2d...", "description": "Local File Inclusion (LFI)", "group": "lfi", "enabled": true, "action": "block", "severity": "high", "exclusions": []}, {"id": "...d992e8ae...4a1b...", "description": "Remote File Inclusion (RFI)", "group": "rfi", "enabled": true, "action": "block", "severity": "high", "exclusions": []}, {"id": "...b508c6ef...7d3a...", "description": "Remote Code Execution (RCE)", "group": "rce", "enabled": true, "action": "block", "severity": "critical", "exclusions": []}, {"id": "...a123b789...c5d6...", "description": "PHP Injection Attacks", "group": "php_injection", "enabled": true, "action": "block", "severity": "high", "exclusions": []}, {"id": "...e456f012...a7b8...", "description": "Command Injection", "group": "cmd_injection", "enabled": true, "action": "block", "severity": "critical", "exclusions": []}]}, {"name": "OWASP Core Rule Set", "id": "owasp_crs", "version": "3.3.0", "enabled": true, "action": "managed", "paranoia_level": 2, "anomaly_score_threshold": {"low": 5, "medium": 10, "high": 20}}, {"name": "Custom AlgeriaTrade Rules", "id": "algeriatrade_custom", "version": "1.0.0", "enabled": true, "action": "custom", "rules": [{"id": "at-custom-001", "name": "Block Suspicious User Agents", "description": "Block known malicious and scraping user agents", "expression": "(http.user_agent contains \"sqlmap\" or http.request.uri.path contains \"wp-admin\" or http.user_agent contains \"nikto\" or http.user_agent contains \"nmap\" or http.user_agent contains \"masscan\" or http.user_agent contains \"gobuster\" or http.user_agent contains \"dirbuster\" or http.user_agent contains \"wfuzz\" or http.user_agent contains \"hydra\" or http.user_agent contains \"medusa\")", "action": "block", "logging": {"enabled": true, "metadata": {"category": "reconnaissance", "severity": "medium"}}}, {"id": "at-custom-002", "name": "Block Path Traversal Attempts", "description": "Detect and block directory traversal attacks", "expression": "(http.request.uri.path contains \"../\" or http.request.uri.path contains \"..\\\" or http.request.uri.query contains \"%2e%2e%2f\" or http.request.uri.query contains \"..%2f\" or http.request.uri.query contains \"%2e%2e/\")", "action": "block", "logging": {"enabled": true, "metadata": {"category": "path_traversal", "severity": "high"}}}, {"id": "at-custom-003", "name": "Rate Limit - Login Endpoints", "description": "Aggressive rate limiting for authentication endpoints", "expression": "(http.request.uri.path eq \"/api/auth/login\" or http.request.uri.path eq \"/api/auth/register\" or http.request.uri.path eq \"/api/auth/forgot-password\")", "action": {"type": "rate_limit", "rate_limit": {"characteristics": ["ip.src"], "period": 60, "requests_per_period": 10, "counting_expression": "true", "mitigation_timeout": 600}}, "logging": {"enabled": true, "metadata": {"category": "auth_abuse", "severity": "high"}}}, {"id": "at-custom-004", "name": "Rate Limit - API Endpoints General", "description": "Standard rate limiting for API endpoints", "expression": "starts_with(http.request.uri.path, \"/api/\")", "action": {"type": "rate_limit", "rate_limit": {"characteristics": ["ip.src"], "period": 60, "requests_per_period": 300, "counting_expression": "true", "mitigation_timeout": 300}}, "logging": {"enabled": true, "metadata": {"category": "api_rate_limit", "severity": "low"}}}, {"id": "at-custom-005", "name": "Rate Limit - Search Endpoint", "description": "Specific rate limiting for search to prevent abuse", "expression": "starts_with(http.request.uri.path, \"/api/search\")", "action": {"type": "rate_limit", "rate_limit": {"characteristics": ["ip.src"], "period": 60, "requests_per_period": 60, "counting_expression": "true", "mitigation_timeout": 120}}, "logging": {"enabled": true, "metadata": {"category": "search_abuse", "severity": "medium"}}}, {"id": "at-custom-006", "name": "Block Empty User Agent", "description": "Block requests with empty user agents (often bots)", "expression": "length(http.user_agent) eq 0", "action": "js_challenge", "logging": {"enabled": true, "metadata": {"category": "bot_detection", "severity": "low"}}}]}]}, "bot_management": {"enabled": true, "mode": "active", "fight_mode": false, "super_bot_fight_mode": false, "actions": {"definitely_automated": "block", "likely_automated": "managed_challenge", "verified_bots": "allow", "js_interstitial": "skip"}, "allowed_bots": {"search_engines": [{"name": "Googlebot", "user_agents": ["Googlebot/", "Googlebot-Image/", "Googlebot-News/", "Googlebot-Video/", "Googlebot-Mobile/", "Mediapartners-Google/", "AdsBot-Google/"], "action": "allow"}, {"name": "Bingbot", "user_agents": ["bingbot/", "adidxbot/", "msnbot-media/", "BingPreview/"], "action": "allow"}, {"name": "Yahoo Slurp", "user_agents": ["Slurp"], "action": "allow"}, {"name": "DuckDuckBot", "user_agents": ["DuckDuckBot"], "action": "allow"}, {"name": "Baiduspider", "user_agents": ["Baiduspider"], "action": "allow"}, {"name": "YandexBot", "user_agents": ["YandexBot/", "YandexImages/", "YandexVideo/", "YandexAccessibility/", "YandexMetrika/", "YandexDirect/", "YandexWebmaster/"], "action": "allow"}], "monitoring_tools": [], "blocked_bots": {"scrapers": [{"name": "Generic Scrapers", "patterns": ["curl", "wget", "python-requests", "httpclient", "java/", "go-http", "okhttp", "axios/", "node-superagent", "scrapy", "mechanize", "phantomjs", "selenium", "puppeteer", "playwright"], "action": "block"}, {"name": "Commercial Scrapers", "patterns": ["AhrefsBot", "SemrushBot", "MJ12bot", "DotBot", "BLEXBot", "Exabot", "MauiBot", "AspiegelBot", "DataForSeoBot", "PetalBot", "Applebot"], "action": "block"}], "aggressive_bots": [{"name": "Vulnerability Scanners", "patterns": ["nikto", "nmap", "masscan", "openvas", "nessus", "qualys", "acunetix", "burpsuite", "owasp_zap", "w3af", "arachni", "skipfish", "whatweb"], "action": "block"}]}}, "session_integrity": {"enabled": true, "check_ip_binding": true, "check_user_agent_binding": true}}, "rate_limiting": {"global_limits": {"enabled": true, "default_action": "throttle", "throttle_response_code": 429, "retry_after_header": true, "limits": [{"name": "Global Requests Per IP", "characteristics": ["ip.src"], "period_seconds": 60, "threshold": 1000, "action": "simulate"}, {"name": "Global Requests Per IP - Burst", "characteristics": ["ip.src"], "period_seconds": 10, "threshold": 200, "action": "throttle"}]}, "endpoint_specific": [{"pattern": "/api/auth/*", "limits": [{"name": "Auth Rate Limit", "characteristics": ["ip.src"], "period_seconds": 60, "threshold": 10, "action": "block", "cooldown_seconds": 900}], "response_headers": {"X-RateLimit-Limit": "10", "X-RateLimit-Remaining": "{remaining}", "X-RateLimit-Reset": "{reset_time}"}}, {"pattern": "/api/payments/*", "limits": [{"name": "Payment Rate Limit", "characteristics": ["ip.src", "http.cookie:_at_session"], "period_seconds": 60, "threshold": 30, "action": "block", "cooldown_seconds": 3600}], "response_headers": {"X-RateLimit-Limit": "30", "X-RateLimit-Remaining": "{remaining}", "X-RateLimit-Reset": "{reset_time}"}}, {"pattern": "/api/search*", "limits": [{"name": "Search Rate Limit"