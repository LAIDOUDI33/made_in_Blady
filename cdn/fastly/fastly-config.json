{"$schema": "https://json-schema.org/draft/2020-12/schema", "version": "1.0.0", "platform": "fastly", "service_name": "AlgeriaTrade CDN Service", "service_id": "${FASTLY_SERVICE_ID}", "description": "Fastly CDN Configuration for AlgeriaTrade.dz - MENA Optimized", "lastUpdated": "2024-12-01T00:00:00Z", "configuration": {"general": {"name": "algeriatrade-dz-cdn", "comment": "Production CDN service for AlgeriaTrade platform - MENA optimized", "version": {"number": 1, "active": true, "created_at": "2024-12-01T00:00:00Z", "deployed_by": "CDN Automation"}}, "domains": [{"name": "algeriatrade.dz", "comment": "Primary domain (apex)"}, {"name": "www.algeriatrade.dz", "comment": "WWW subdomain"}, {"name": "api.algeriatrade.dz", "comment": "API endpoint domain"}, {"name": "cdn.algeriatrade.dz", "comment": "Static assets CDN domain"}, {"name": "static.algeriatrade.dz", "comment": "Static assets alternative domain"}, {"name": "img.algeriatrade.dz", "comment": "Image optimization domain"}, {"name": "staging.algeriatrade.dz", "comment": "Staging environment domain"}], "origins": [{"name": "origin_production", "address": "origin.algeriatrade.internal", "port": 443, "ssl": true, "ssl_cert_hostname": "origin.algeriatrade.internal", "ssl_sni_hostname": "origin.algeriatrade.internal", "shield": "MRS-Marseille", "comment": "Primary production origin server", "health_check": {"host": "origin.algeriatrade.internal", "path": "/api/health", "method": "GET", "expected_response": 200, "check_interval": 15, "timeout": 5, "window": 5, "threshold": 3, "initial": 2, "http_version": "1.1", "headers": [{"name": "Host", "value": "Origin: origin.algeriatrace.internal"}, {"name": "User-Agent", "value": "Fastly-HealthCheck/1.0"}]}}, {"name": "image_optimizer", "address": "image-optimizer.algeriatrade.internal", "port": 443, "ssl": true, "shield": null, "comment": "Image optimization microservice", "health_check": {"host": "image-optimizer.algeriatrade.internal", "path": "/health", "method": "GET", "expected_response": 200, "check_interval": 30, "timeout": 3}}, {"name": "api_gateway", "address": "api-gateway.algeriatrade.internal", "port": 443, "ssl": true, "shield": "MRS-Marseille", "comment": "API gateway backend"}], "tls": {"certificates": [{"id": "${FASTLY_TLS_CERT_ID}", "name": "algeriatrade-dz-wildcard", "type": "LETSENCRYPT", "domains": ["*.algeriatrade.dz", "algeriatrade.dz"], "issued_at": "2024-12-01T00:00:00Z", "expires_at": "2025-03-01T00:00:00Z", "auto_renew": true, "managed_http": true, "managed_https": true}], "minimum_tls_version": "1.2", "supported_tls_versions": ["1.2", "1.3"], "client_cert": null, "http2": true, "http3": true}, "caching": {"settings": {"default_ttl": 3600, "stale_if_error": 86400, "stale_while_revalidate": 3600}, "rules": [{"name": "Static Assets - Long Cache", "action": "cache", "ttl": 31536000, "stale_while_revalidate": 2592000, "stale_if_error": 2592000, "conditions": {"request": ["url.path matches '^/_next/static/'", "url.path matches '^/static/'", "url.ext in {js css woff2 woff ttf eot}"]}}, {"name": "Images - Medium Cache", "action": "cache", "ttl": 2592000, "stale_while_revalidate": 604800, "stale_if_error": 604800, "conditions": {"request": ["url.ext in {png jpg jpeg gif webp avif svg}", "url.path matches '^/(images|uploads|cdn)/'"]}}, {"name": "HTML Pages - Medium Cache", "action": "cache", "ttl": 300, "stale_while_revalidate": 3600, "stale_if_error": 3600, "conditions": {"request": ["content_type == 'text/html'", "!url.path matches '^/(account|dashboard|checkout|admin)'"]}}, {"name": "API Responses - Short Cache", "action": "cache", "ttl": 60, "stale_while_revalidate": 300, "stale_if_error": 300, "conditions": {"request": ["url.path matches '^/api/'", "method == 'GET'", "!url.path matches '^/api/(auth|payments|webhooks|cart|checkout)'"]}}, {"name": "Dynamic Content - No Cache", "action": "pass", "conditions": {"request": ["method != 'GET' && method != 'HEAD'", "url.path matches '^/api/auth/'", "url.path matches '^/api/payments/'", "url.path matches '^/api/webhooks/'"]}}]}, "image_optimizer": {"enabled": true, "settings": {"formats": {"webp": {"quality": 80, "enabled": true}, "avif": {"quality": 75, "enabled": true}}, "resize": {"enabled": true, "max_width": 1920, "max_height": 1080, "device_sizes": [640, 750, 828, 1080, 1200, 1920, 2048, 3840], "image_sizes": [16, 32, 48, 64, 96, 128, 256, 384]}, "fallback_format": "original", "preserve_original": true}}}, "shielding": {"enabled": true, "primary_pop": "MRS-Marseille", "secondary_pop": "LHR-London", "connect_timeout_ms": 10000, "first_byte_timeout_ms": 30000, "between_bytes_timeout_ms": 15000, "max_connections": 500, "enable_stale_delivery": true, "stale_delivery_ttl": 86400}, "geographic_routing": {"enabled": true, "rules": [{"name": "Algeria Priority Routing", "priority": 100, "target_countries": ["DZ"], "preferred_pops": ["ALG-Algiers", "ORN-Oran", "CST-Constantine"], "cache_ttl_override": 180, "latency_target_ms": 50, "description": "Route Algerian traffic to local POPs for <50ms latency"}, {"name": "MENA Regional Routing", "priority": 90, "target_countries": ["TN", "MA", "LY", "EG", "MR", "TG"], "preferred_pops": ["TUN-Tunis", "CAS-Casablanca", "CAI-Cairo", "VAL-Valencia", "MRS-Marseille"], "cache_ttl_override": 120, "latency_target_ms": 80, "description": "Route MENA traffic to nearest regional POPs"}, {"name": "France/Europe Routing", "priority": 80, "target_countries": ["FR", "ES", "IT", "DE", "GB", "BE", "CH"], "preferred_pops": ["PAR-Paris", "FRA-Frankfurt", "LON-London", "AMS-Amsterdam", "MAD-Madrid"], "cache_ttl_override": 90, "latency_target_ms": 100, "description": "Route European traffic to European POPs"}, {"name": "Global Default Routing", "priority": 70, "target_countries": ["*"], "preferred_pops": ["auto"], "cache_ttl_override": 60, "latency_target_ms": 200, "description": "Default routing for all other regions"}]}, "rate_limiting": {"enabled": true, "rules": [{"name": "Global Rate Limit", "rate_limit_per_minute"