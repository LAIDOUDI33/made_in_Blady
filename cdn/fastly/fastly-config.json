ent}i\",\n  \"pop\": \"{server.identity}\",\n  \"response_time\": %T\n}", "sampling_rate": 10, "compression": "gzip"}]}, "batch": {"enabled": true, "providers": [{"name": "CloudWatch Logs", "type": "cloudwatch", "region": "eu-west-3", "log_group_name": "/fastly/algeriatrade/access", "log_stream_name": "production", "iam_role_arn": "${FASTLY_CW_ROLE_ARN}", "format": {"timestamp": "%{begin:%Y-%m-%dT%H:%M:%S}t", "client_ip": "%h", "method": "%m", "url": "%U%q", "status": "%s", "cache_status": "%{fastly_info.state}x", "bytes_sent": "%B", "referer": "%{Referer}i", "user_agent": "%{User-Agent}i", "country": "{client.geo.country_code}", "city": "{client.geo.city}", "asn": "{client.geo.as_number}"}, "sampling_rate": 100, "compression": "gzip"}]}}, "monitoring": {"alerts": {"enabled": true, "channels": [{"type": "email", "recipients": ["ops@algeriatrade.dz", "cdn-alerts@algeriatrade.dz"]}, {"type": "pagerduty", "integration_key": "${PAGERDUTY_KEY}"}, {"type": "slack", "webhook_url": "${SLACK_WEBHOOK_URL}"}], "rules": [{"name": "High Error Rate", "metric": "errors_total", "threshold": 5, "window_minutes": 5, "comparison": "greater_than", "severity": "critical"}, {"name": "High Latency", "metric": "p95_latency_ms", "threshold": 1000, "window_minutes": 5, "comparison": "greater_than", "severity": "warning"}, {"name": "Low Hit Ratio", "metric": "hit_ratio_percent", "threshold": 80, "window_minutes": 60, "comparison": "less_than", "severity": "warning"}, {"name": "Origin Health Check Failure", "metric": "origin_health", "threshold": 0, "window_minutes": 1, "comparison": "equals", "severity": "critical"}]}}}, "feature_flags": {"dictionary_name": "algeriatrade_feature_flags", "items": {"new_ui_design": {"value": "true", "description": "Enable new UI design for all users"}, "advanced_search": {"value": "true", "description": "Enable advanced search functionality"}, "real_time_chat": {"value": "false", "description": "Enable real-time chat feature (beta)"}, "ai_recommendations": {"va