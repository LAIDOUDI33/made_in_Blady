{"_comment": "Odoo Configuration Example - AlgeriaTrade.dz ERP Integration", "_version": "1.0", "_last_updated": "2025-01-15", "connection": {"name": "Odoo 17 Enterprise Production", "erp_type": "odoo", "environment": "production", "description": "Odoo Enterprise integration for product, inventory, and order sync", "odoo_version": "17.0"}, "host_configuration": {"url": "https://odoo.yourcompany.com", "port": 443, "database": "production_main", "ssl_verify": true}, "authentication": {"type": "api_key", "api_key": "${ODOO_API_KEY}", "username": "integration_user@yourcompany.com", "password": "", "_note_on_auth": "For Odoo 16+, API key is recommended. For XML-RPC auth, provide username/password.", "_where_to_find_api_key": "Odoo Settings → General Settings → API Keys → Generate key for user"}, "odoo_models": {"product_template": {"model": "product.template", "fields_to_sync": ["name", "type", "sale_ok", "purchase_ok", "list_price", "standard_price", "description", "description_sale", "weight", "volume", "default_code"], "domain": "[('sale_ok', '=', True)]", "field_mapping": {"name": "title", "default_code": "sku", "list_price": "price", "standard_price": "cost_price", "description_sale": "description", "weight": "weight_kg", "type": "product_type", "categ_id": "category_id"}}, "product_product": {"model": "product.product", "fields_to_sync": ["barcode", "default_code", "active", "qty_available"], "field_mapping": {"barcode": "barcode", "default_code": "sku", "active": "is_visible", "qty_available": "stock_quantity"}},"stock_quant": {"model": "stock.quant", "fields_to_sync": ["product_id", "location_id", "quantity", "reserved_quantity"], "domain": "[('location_id.usage', '=', 'internal')]", "field_mapping": {"product_id.default_code": "sku", "location_id.complete_name": "warehouse_location", "quantity": "available_quantity", "reserved_quantity": "reserved_quantity"}},"sale_order": {"model": "sale.order", "fields_to_sync": ["name", "partner_id", "state", "amount_total", "date_order", "note"], "field_mapping": {"name": "order_number", "partner_id.email": "customer_email", "partner_id.name": "customer_company", "state": "status", "amount_total": "total_amount", "note": "customer_notes"},"status_mapping": {"draft": "pending_confirmation", "sent": "pending_confirmation", "sale": "confirmed", "done": "completed", "cancel": "cancelled"}},"sale_order_line": {"model": "sale.order.line", "fields_to_sync": ["order_id", "product_id", "product_uom_qty", "price_unit", "price_subtotal"], "field_mapping": {"order_id.name": "order_number", "product_id.default_code": "sku", "product_id.name": "product_name", "product_uom_qty": "quantity", "price_unit": "unit_price", "price_subtotal": "line_total"}}}, "sync_settings": {"default_direction": "bidirectional", "conflict_resolution_strategy": "erp_wins", "schedules": {"products": {"frequency": "0 */4 * * *", "method": "xmlrpc", "type": "incremental", "write_date_field": "write_date"}, "inventory": {"frequency": "*/15 * * * *", "method": "xmlrpc", "type": "full", "_note": "Odoo inventory is fast; full sync acceptable every 15 min"}, "orders": {"frequency": "*/5 * * * *", "method": "xmlrpc", "direction": "pull_only", "domain": "[('state', 'not in', ['draft', 'cancel'])]"}, "order_status_updates": {"frequency": "*/3 * * * *", "method": "xmlrpc", "direction": "push_only"}}}, "advanced_settings": {"pagination": {"type": "offset", "limit_param": "limit", "offset_param": "offset", "page_size": 100}, "timeout_seconds": 60, "retry_settings": {"max_retries": 3, "backoff_multiplier": 2, "initial_delay_ms": 2000}, "logging": {"level": "debug", "log_odoo_queries": false, "include_response_data": false}, "performance": {"parallel_requests": 3, "batch_size": 50}}, "category_mapping": {"enabled": true, "source_field": "categ_id", "mapping_method": "id_based", "mappings": {"odoo_category_id": "algeriatrade_taxonomy_id", "examples": {"1": "CAT-099", "2": "CAT-001", "3": "CAT-002", "4": "CAT-003", "5": "CAT-004", "6": "CAT-005", "7": "CAT-006"}, "fallback_category": "CAT-099", "auto_create_missing": false}, "uom_mapping": {"enabled": true, "source_field": "uom_id", "mappings": {"1": "unit", "5": "box", "17": "carton", "6": "kg", "11": "liter", "12": "meter", "16": "pack"}}, "warehouse_mapping": {"enabled": true, "source_field": "location_id", "mappings": {"8": "WH-ALGIERS-MAIN", "9": "WH-ORAN", "10": "WH-CONSTANTINE"}, "include_virtual_locations": false}, "webhook_configuration": {"enabled": true, "supported_events": ["product.created", "product.updated", "inventory.updated", "order.created", "order.updated", "order.cancelled"], "odoo_webhook_module_required": true, "_webhook_setup_note": "Install web_webhook module from Odoo Apps or use custom controller"}, "_example_usage": {"note": "This is a template. Replace placeholder values with your actual Odoo configuration.", "steps": ["1. Copy this file to your config location", "2. Set correct URL for your Odoo instance", "3. Specify your database name", "4. Generate and configure API key securely", "5. Adjust model names if using custom modules", "6. Map category IDs to AlgeriaTaxonomy", "7. Test connection before going live"]}}}