{"_comment": "Custom REST API Configuration Example - AlgeriaTrade.dz ERP Integration", "_version": "1.0", "_last_updated": "2025-01-15", "connection": {"name": "Custom ERP REST API Integration", "erp_type": "rest_api", "environment": "production", "description": "Generic REST API connector for custom/unsupported ERP systems"}, "host_configuration": {"base_url": "https://api.your-erp-system.com/v2", "port": 443, "ssl_verify": true, "api_version": "2.0"}, "authentication": {"type": "bearer_token", "_supported_types": ["bearer_token", "basic", "api_key_header", "api_key_query", "oauth2"], "configuration": {"header_name": "Authorization", "token_prefix": "Bearer", "token": "${ERP_API_TOKEN}", "_alternative_basic": {"username": "${ERP_API_USER}", "password": "${ERP_API_PASSWORD}"}, "_alternative_api_key_header": {"header_name": "X-API-Key", "key": "${ERP_API_KEY}"}, "_alternative_oauth2": {"token_url": "https://auth.your-erp.com/oauth/token", "client_id": "${OAUTH_CLIENT_ID}", "client_secret": "${OAUTH_CLIENT_SECRET}", "scope": "api.read api.write"}}}, "endpoints": {"products": {"list": {"method": "GET", "path": "/products", "description": "List all products with optional filtering", "parameters": {"limit": {"type": "query", "name": "limit", "default": 100, "max": 500}, "offset": {"type": "query", "name": "offset", "default": 0}, "modified_since": {"type": "query", "name": "updated_at[gte]", "format": "datetime"}, "status": {"type": "query", "name": "status", "options": ["active", "inactive"]}}, "response_wrapper": "$.data", "pagination": {"type": "offset", "total_field": "$.meta.total_count"}}, "get": {"method": "GET", "path": "/products/{id}", "description": "Get single product by ID or SKU", "path_parameters": {"id": {"source": "sku", "required": true}}}, "create": {"method": "POST", "path": "/products", "description": "Create new product", "request_body": {"content_type": "application/json", "field_mapping": "reverse_of_products_mapping"}}, "update": {"method": "PUT", "path": "/products/{id}", "description": "Update existing product", "path_parameters": {"id": {"source": "sku"}}}}, "inventory": {"list": {"method": "GET", "path": "/inventory", "description": "List inventory records", "parameters": {"warehouse_id": {"type": "query", "name": "warehouse_id"}, "sku": {"type": "query", "name": "sku"}}}, "update": {"method": "PUT", "path": "/inventory/{sku}", "description": "Update stock quantity for SKU", "path_parameters": {"sku": {"source": "sku"}}, "request_body": {"fields": {"quantity": "integer", "warehouse_id": "string"}}}, "adjust": {"method": "PATCH", "path": "/inventory/{sku}/adjust", "description": "Adjust stock by delta (positive or negative)", "path_parameters": {"sku": {"source": "sku"}}, "request_body": {"fields": {"delta": "integer", "reason": "string", "reference": "string"}}}}, "orders": {"list": {"method": "GET", "path": "/orders", "description": "List orders", "parameters": {"status": {"type": "query", "name": "status"}, "date_from": {"type": "query", "name": "created_at[gte]", "format": "datetime"}, "date_to": {"type": "query", "name": "created_at[lte]", "format": "datetime"}}}, "get": {"method": "GET", "path": "/orders/{id}", "description": "Get order details", "path_parameters": {"id": {"source": "order_id"}}}, "create": {"method": "POST", "path": "/orders", "description": "Create new order from marketplace", "request_body": {"content_type": "application/json", "field_mapping": "reverse_of_orders_mapping"}}, "update_status": {"method": "PUT", "path": "/orders/{id}/status", "description": "Update order status", "path_parameters": {"id": {"source": "order_id"}}, "request_body": {"fields": {"status": "enum", "notes": "string", "timestamp": "datetime"}}}}}, "response_formats": {"success_response": {"wrapper_path": "$.data", "item_wrapper": null, "error_path": "$.error", "message_path": "$.error.message", "code_path": "$.error.code"}, "date_format": "ISO8601", "timezone": "UTC", "null_handling": "omit_or_default"}, "sync_settings": {"default_direction": "bidirectional", "conflict_resolution_strategy": "last_write_wins", "schedules": {"products": {"frequency": "0 */6 * * *", "method": "rest_polling", "type": "incremental", "modified_field": "updated_at"}, "inventory": {"frequency": "*/15 * * * *", "method": "rest_polling", "type": "full"}, "orders_pull": {"frequency": "*/5 * * * *", "method": "rest_polling", "direction": "pull_only"}, "orders_push": {"frequency": "realtime", "method": "webhook", "direction": "push_only"}}}, "field_mappings": {"products_source_to_target": [{"source": "id", "target": "external_id", "transformations": []}, {"source": "sku", "target": "sku", "transformations": ["TRIM", "UPPERCASE"]}, {"source": "name", "target": "title", "transformations": ["TRIM"]}, {"source": "description", "target": "description", "transformations": []}, {"source": "price", "target": "price", "transformations": ["ROUND(2)"]}, {"source": "currency_code", "target": "currency", "default_value": "DZD"}, {"source": "stock_quantity", "target": "stock_quantity", "transformations": ["ROUND(0)"]}, {"source": "category_code", "target": "category_id", "lookup_table": {"ELEC": "CAT-001", "TEXT": "CAT-002", "MACH": "CAT-003", "FOOD": "CAT-004", "CHEM": "CAT-005", "CONST": "CAT-006"}}, {"source": "brand", "target": "brand", "transformations": []}, {"source": "weight_kg", "target": "weight", "transformations": ["ROUND(3)"]}, {"source": "is_active", "target": "status", "value_map": {"true": "active", "false": "draft"}}, {"source": "image_url", "target": "images", "transformations": ["ARRAY_WRAP"]}],"orders_target_to_source": [{"target": "customer_name", "source": "buyer.company_name"}, {"target": "customer_email", "source": "buyer.email"}, {"target": "items", "source": "line_items", "array_mapping": {"product_sku": "sku", "quantity": "qty", "unit_price": "unit_price", "line_total": "total"}}, {"target": "shipping_address.street", "source": "shipping_address.address_line1"}, {"target": "shipping_address.city", "source": "shipping_address.city"}, {"target": "shipping_address.postal_code", "source": "shipping_address.postal_code"}, {"target": "shipping_address.country_code", "source": "shipping_address.country"}, {"target": "total_amount", "source": "totals.grand_total"}, {"target": "notes", "source": "notes"}]}, "advanced_settings": {"pagination": {"type": "offset", "limit_param": "limit", "offset_param": "offset", "page_size": 100, "max_limit": 500}, "timeout_seconds": 30, "connection_timeout": 10, "read_timeout": 20, "retry_settings": {"max_retries": 3, "retry_on_status_codes": [429, 500, 502, 503, 504], "backoff_multiplier": 2, "initial_delay_ms": 1000, "jitter": true}, "rate_limiting": {"enabled": true, "requests_per_second": 10, "burst_size": 20, "retry_after_header": "X-RateLimit-Reset"}, "logging": {"level": "info", "log_request_headers": false, "log_request_body": false, "log_response_headers": true, "log_response_body": false, "mask_sensitive_fields": ["password", "token", "secret", "key"]}, "caching": {"enabled": true, "ttl_seconds": 300, "cache_by_default": ["products.list"]}, "webhook_configuration": {"enabled": true, "incoming_webhook_endpoint": "/api/webhooks/algeriatrade", "signature_header": "X-Signature", "signature_algorithm": "HMAC-SHA256", "signing_secret": "${WEBHOOK_SECRET}"}, "_example_usage": {"note": "This is a template for custom REST API integrations.", "steps": ["1. Copy this file to your config location", "2. Set base_url to your ERP's API endpoint", "3. Configure authentication method used by your API", "4. Adjust endpoint paths to match your API structure", "5. Map response fields in field_mappings section", "6. Test each endpoint individually", "7. Run full integration test before going live"], "_customization_tips": ["If your API uses different pagination, adjust pagination settings", "For nested JSON responses, update response_formats.wrapper_path", "Add custom transformations if data needs conversion", "Configure rate limiting to match your API's limits"]}}}