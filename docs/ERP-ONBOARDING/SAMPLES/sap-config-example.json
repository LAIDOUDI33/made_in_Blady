{"_comment": "SAP S/4HANA Configuration Example - AlgeriaTrade.dz ERP Integration", "_version": "1.0", "_last_updated": "2025-01-15", "connection": {"name": "SAP S/4HANA Production", "erp_type": "sap_s4hana", "environment": "production", "description": "Primary SAP S/4HANA integration for product and inventory sync"}, "host_configuration": {"host_url": "https://your-sap-system.company.com", "port": 44300, "client_id": "100", "system_id": "PRO"}, "authentication": {"type": "oauth2_client_credentials", "grant_type": "client_credentials", "token_endpoint": "/oauth/token", "client_id": "sb-algeriatrade-integration!t1", "client_secret": "${SAP_CLIENT_SECRET}", "scope": "API_PRODUCT_SRV API_INVENTORY_SRV API_SALES_ORDER_SRV", "_note_on_secrets": "Never hardcode secrets. Use environment variables or secrets manager."}, "odata_services": {"base_path": "/sap/opu/odata/sap/", "services": {"product_service": {"name": "API_PRODUCT_SRV", "entity_set": "A_Product", "key_field": "Product", "fields": {"Product": "sku", "ProductType": "product_type", "ProductCategory": "category_code", "ProductName": "title", "ProductOldNumber": "legacy_sku"}}, "product_description": {"name": "API_PRODUCT_SRV", "entity_set": "A_ProductDescription", "language_field": "Language", "fields": {"ProductDescription": "description"}}, "inventory_service": {"name": "API_INVENTORY_SRV_02", "entity_set": "A_MaterialStock", "key_fields": ["Material", "Plant"], "fields": {"Material": "sku", "Plant": "plant_code", "StorageLocation": "storage_location", "AvailableStock": "quantity", "StockInTransitQty": "in_transit_qty", "QualityInspectionStockQty": "inspection_qty"}}, "sales_order_service": {"name": "API_SALES_ORDER_SRV", "entity_set": "A_SalesOrder", "key_field": "SalesOrder", "fields": {"SalesOrder": "order_id", "SoldToParty": "customer_id", "TotalNetAmount": "total_amount", "TransactionCurrency": "currency", "OverallStatus": "status"}}}}, "sync_settings": {"default_direction": "bidirectional", "conflict_resolu